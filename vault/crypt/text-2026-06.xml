<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="del-text-2026-06-crypt"><teiHeader><fileDesc><titleStmt><title>Recorded items for month 2026-06</title></titleStmt><publicationStmt><ab>published electronically as part of the TLS project at https://hxwd.org</ab></publicationStmt><sourceDesc><p>Created by members of the TLS project</p></sourceDesc></fileDesc><profileDesc><creation>Initially created: <date>2026-06-22T06:19:10.504+09:00</date>.</creation></profileDesc></teiHeader><text><body><div><head>Items</head><p xml:id="del-2026-06-start"><seg xml:id="T52n2102_CBETA_001-0003c2701.s40" modified="2026-06-22T06:19:10.504+09:00" resp-change="#CH">須大<anchor xml:id="beg_4" type="star"/>挐<anchor xml:id="end_4"/>覩世之無常財<lb n="0004a11" ed="T"/>貨非己寶故<c n="。"/></seg><seg xml:id="T52n2102_CBETA_001-0003c2701.s41" modified="2026-06-22T06:19:35.336+09:00" resp-change="#CH">恣意布施以成大道<c n="。"/></seg><seg xml:id="T52n2102_CBETA_001-0004c2601.s26" modified="2026-06-23T04:28:55.924+09:00" resp-change="#CH">顯節亦於其上作佛圖像<c n="。"/></seg><seg xml:id="T52n2102_CBETA_001-0004c2601.s25" modified="2026-06-23T04:29:09.261+09:00" resp-change="#CH">明<anchor xml:id="nkr_note_orig_0005004" n="0005004"/><anchor xml:id="nkr_note_mod_0005004" n="0005004"/><anchor xml:id="beg0005004" n="0005004"/>帝<anchor xml:id="end0005004"/>時豫<lb n="0005a07" ed="T"/>修造壽<anchor xml:id="nkr_note_orig_0005005" n="0005005"/><anchor xml:id="nkr_note_mod_0005005" n="0005005"/><anchor xml:id="beg0005005" n="0005005"/>陵<anchor xml:id="end0005005"/>曰<c n="。"/></seg><seg xml:id="T52n2102_CBETA_001-0005b0301.s3" modified="2026-06-23T19:26:43.719+09:00" resp-change="#CH">世人學<lb n="0005b04" ed="T"/>士多<anchor xml:id="nkr_note_orig_0005013" n="0005013"/><anchor xml:id="nkr_note_mod_0005013" n="0005013"/><anchor xml:id="beg0005013" n="0005013"/>謗<anchor xml:id="end0005013"/>毀之云<c n="。"/></seg><seg xml:id="T52n2102_CBETA_001-0005b0301.s4" modified="2026-06-23T19:26:57.153+09:00" resp-change="#CH">其辭說廓落難用<c n="。"/></seg><seg xml:id="T52n2102_CBETA_001-0006a0401.s3" modified="2026-06-24T00:35:31.657+09:00" resp-change="#CH">長<lb n="0006a05" ed="T"/>生之事與佛經豈同乎<c n="。"/></seg><seg xml:id="T52n2102_CBETA_001-0006a0401.s2" modified="2026-06-24T00:35:42.891+09:00" resp-change="#CH">王喬赤松八<anchor xml:id="nkr_note_orig_0006002" n="0006002"/><anchor xml:id="nkr_note_mod_0006002" n="0006002"/><anchor xml:id="beg0006002" n="0006002"/>仙<anchor xml:id="end0006002"/>之籙神書百七十卷<c n="。"/></seg><seg xml:id="T52n2102_CBETA_001-0006c2901.s1" modified="2026-06-24T03:52:28.994+09:00" resp-change="#CH">問曰道家云<c n="。"/></seg><seg xml:id="T52n2102_CBETA_001-0006c2901.s2" modified="2026-06-24T03:52:45.671+09:00" resp-change="#CH">堯舜周孔七十二弟子<c n="。"/></seg><seg xml:id="T52n2102_CBETA_001-0006c2901.s32" modified="2026-06-24T03:59:02.68+09:00" resp-change="#CH">世人為驗<anchor xml:id="nkr_note_orig_0007004" n="0007004"/><anchor xml:id="nkr_note_mod_0007004" n="0007004"/><anchor xml:id="beg0007004" n="0007004"/>而云<anchor xml:id="end0007004"/>不<lb n="0007a12" ed="T"/><anchor xml:id="nkr_note_orig_0007005" n="0007005"/><anchor xml:id="nkr_note_mod_0007005" n="0007005"/><anchor xml:id="beg0007005" n="0007005"/>死<anchor xml:id="end0007005"/><c n="。"/></seg><seg xml:id="T52n2102_CBETA_001-0006c2901.s33" modified="2026-06-24T03:59:17.446+09:00" resp-change="#CH">豈不惑<anchor xml:id="nkr_note_orig_0007006" n="0007006"/><anchor xml:id="nkr_note_mod_0007006" n="0007006"/><anchor xml:id="beg0007006" n="0007006"/>哉<anchor xml:id="end0007006"/><c n="。"/></seg></p></div></body></text></TEI>