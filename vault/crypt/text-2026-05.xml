<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="del-text-2026-05-crypt"><teiHeader><fileDesc><titleStmt><title>Recorded items for month 2026-05</title></titleStmt><publicationStmt><ab>published electronically as part of the TLS project at https://hxwd.org</ab></publicationStmt><sourceDesc><p>Created by members of the TLS project</p></sourceDesc></fileDesc><profileDesc><creation>Initially created: <date>2026-05-03T17:48:37.551+09:00</date>.</creation></profileDesc></teiHeader><text><body><div><head>Items</head><p xml:id="del-2026-05-start"><seg xml:id="KR1d0052_tls_032-22a.1" modified="2026-05-03T17:48:37.551+09:00" resp-change="#CH">誠為能化<c n="。"/></seg><seg xml:id="KR1d0052_tls_032-21a.10" modified="2026-05-03T17:48:45.358+09:00" resp-change="#CH">唯天下至</seg><seg xml:id="KR2e0001_tls_004-306a.8" modified="2026-05-03T23:12:35.601+09:00" resp-change="#CH">尹鐸損其戶數<c n="。"/>𥳑</seg><seg xml:id="KR2e0001_tls_004-306a.9" modified="2026-05-03T23:12:41.782+09:00" resp-change="#CH">子誡襄子曰<c n="："/></seg><seg xml:id="KR2e0001_tls_004-306a.5" modified="2026-05-03T23:12:51.517+09:00" resp-change="#CH">抑為保鄣乎<c n="？"/><c n="」"/>𥳑</seg><seg xml:id="KR2e0001_tls_004-306a.6" modified="2026-05-03T23:12:59.109+09:00" resp-change="#CH">子曰<c n="："/></seg><seg xml:id="KR2e0001_tls_004-308a.8" modified="2026-05-03T23:13:35.782+09:00" resp-change="#CH">尹鐸往而增之<c n="。"/>𥳑</seg><seg xml:id="KR2e0001_tls_004-308a.9" modified="2026-05-03T23:14:07.334+09:00" resp-change="#CH">子如晉陽<c n="，"/></seg><seg xml:id="KR2a0001_tls_086-27a.21" modified="2026-05-08T18:43:26.587+09:00" resp-change="#dsehnal">北購於單于<c n="，"/>
                    </seg><seg xml:id="KR2a0001_tls_086-27a.21" resp="#dsehnal" modified="2026-05-08T18:47:31.904+09:00" resp-change="#dsehnal">北購媾於單于，</seg><seg xml:id="CH2b1559_CHANT_005-9a.15" modified="2026-05-08T23:20:33.894+09:00" resp-change="#CH">人形躁而志越<c n="，"/></seg><seg xml:id="CH2b1559_CHANT_005-9a.14" modified="2026-05-08T23:20:43.738+09:00" resp-change="#CH">故使<c n="，"/></seg><seg xml:id="CH2b1559_CHANT_005-1a.65" modified="2026-05-14T00:51:38.269+09:00" resp-change="#CH">歌舞非悲哀之主也<c n="。"/></seg></p></div></body></text></TEI>