<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="del-text-2026-02-crypt"><teiHeader><fileDesc><titleStmt><title>Recorded items for month 2026-02</title></titleStmt><publicationStmt><ab>published electronically as part of the TLS project at https://hxwd.org</ab></publicationStmt><sourceDesc><p>Created by members of the TLS project</p></sourceDesc></fileDesc><profileDesc><creation>Initially created: <date>2026-02-05T22:45:54.906+09:00</date>.</creation></profileDesc></teiHeader><text><body><div><head>Items</head><p xml:id="del-2026-02-start"><seg xml:id="KR3j0015_CH7x2006_004-1a.68" modified="2026-02-05T22:45:54.906+09:00" resp-change="#CH">故生惰慢也<c n="。"/>樂者<c n="，"/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.69" modified="2026-02-05T22:46:10.667+09:00" resp-change="#CH">所以和情志<c n="，"/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.85" modified="2026-02-05T22:49:15.827+09:00" resp-change="#CH">非所以範人之道<c n="。"/><c n="」"/>名者<c n="，"/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.86" modified="2026-02-05T22:49:28.303+09:00" resp-change="#CH">所以正尊卑<c n="，"/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.112" modified="2026-02-05T23:03:37.012+09:00" resp-change="#CH">此乖分也<c n="。"/><c n="」"/>刑者<c n="，"/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.114" modified="2026-02-05T23:03:46.116+09:00" resp-change="#CH">亦所以生凌暴<c n="。"/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.114" resp="#CH" modified="2026-02-05T23:21:38.374+09:00" resp-change="#CH">刑者，亦所以生凌暴。</seg><seg xml:id="KR3j0015_CH7x2006_004-1a.113" modified="2026-02-05T23:21:43.666+09:00" resp-change="#CH">所以威不服<c n="，"/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.119" modified="2026-02-05T23:29:03.719+09:00" resp-change="#CH">反賞也<c n="。"/><c n="《"/>文子<c n="》"/>曰<c n="："/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.120" modified="2026-02-05T23:29:21.339+09:00" resp-change="#CH"><c n="「"/>聖人其作書也<c n="，"/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.150" modified="2026-02-05T23:35:44.637+09:00" resp-change="#CH">無傷口中珠<c n="。"/><c n="』"/><c n="」"/>由此言之<c n="，"/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.151" modified="2026-02-05T23:35:47.567+09:00" resp-change="#CH">詩<c n="、"/>禮乃盜資也<c n="。"/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.153" modified="2026-02-05T23:36:26.605+09:00" resp-change="#CH">控音啌<c n="。"/>其作囿也<c n="，"/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.154" modified="2026-02-05T23:36:30.023+09:00" resp-change="#CH">以奉宗廟之具<c n="，"/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.101" modified="2026-02-06T05:50:45.176+09:00" resp-change="#CH">信矣哉<c n="！"/>法者<c n="，"/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.102" modified="2026-02-06T05:50:50.692+09:00" resp-change="#CH">所以齊眾異<c n="，"/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.286" modified="2026-02-06T22:56:56.695+09:00" resp-change="#CH"><c n="「"/>臣專其君<c n="，"/></seg><seg xml:id="KR3j0015_CH7x2006_004-1a.310" modified="2026-02-06T23:05:03.382+09:00" resp-change="#CH"><c n="「"/>儒者以文亂法<c n="，"/></seg><seg xml:id="KR1e0001_tls_001-5a.2" n="A1.1.1" modified="2026-02-26T00:33:14.464+09:00" resp-change="#CH">元年春王正月<c n="。"/></seg><seg xml:id="KR1e0001_tls_001-5a.2" resp="#CH" modified="2026-02-26T00:38:14.179+09:00" resp-change="#CH">A1.1.1　元年春王正月，不書即位，攝也。。</seg><seg xml:id="KR1e0001_tls_001-82a.13" modified="2026-02-27T01:59:06.89+09:00" resp-change="#CH">敝邑以賦與陳<c n="、"/></seg><seg xml:id="KR1e0001_tls_001-82a.14" modified="2026-02-27T01:59:13.552+09:00" resp-change="#CH">蔡從<c n="，"/></seg><seg xml:id="KR1e0001_tls_001-82a.17" modified="2026-02-27T02:03:49.815+09:00" resp-change="#CH">於是陳<c n="、"/></seg><seg xml:id="KR1e0001_tls_001-82a.18" modified="2026-02-27T02:11:05.349+09:00" resp-change="#CH">蔡方睦於衛<c n="，"/></seg></p></div></body></text></TEI>