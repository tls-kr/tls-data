                    <seg corresp="#KR5c0386_tls_007-581a.3" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-08-31T03:29:09.96+09:00" resp-del="#gemini-2.0-flash" src-id="KR5c0386-en-3c235c9d">Lacquer supplies utensils,</seg>
                    <seg corresp="#KR5c0386_tls_007-580a.3" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-08-31T03:32:38.959+09:00" resp-del="#gemini-2.0-flash" src-id="KR5c0386-en-3c235c9d">Trees grow into axe handles,</seg>
                    <seg corresp="#KR5c0386_tls_007-581a.3" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-08-31T03:29:09.96+09:00" resp-del="#gemini-2.0-flash" src-id="KR5c0386-en-3c235c9d">Lacquer supplies utensils,</seg>
                    <seg corresp="#KR5c0386_tls_007-582a.3" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-08-31T03:27:20.46+09:00" resp-del="#gemini-2.0-flash" src-id="KR5c0386-en-3c235c9d">To cut off one's skin for the sake of the world,</seg>
