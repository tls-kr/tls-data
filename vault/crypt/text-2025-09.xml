        <body>
            <div>
                <head>Items</head>
                <p xml:id="del-2025-09-start">
                    <seg xml:id="KR3e0001_tls_020-3a.9" modified="2025-09-16T00:22:04.807+09:00" resp-change="#CH">死<c n="。"/>形氣相得者<c n="，"/>
                    </seg>
                    <seg xml:id="KR3e0001_tls_020-3a.8" modified="2025-09-16T00:22:16.036+09:00" resp-change="#CH">胸中多氣者<c n="，"/>
                    </seg>
                    <seg xml:id="KR3e0001_tls_020-3a.10" modified="2025-09-16T00:22:23.426+09:00" resp-change="#CH">生<c n="。"/>參伍不調者<c n="，"/>
                    </seg>
                    <seg xml:id="KR3e0001_tls_020-3a.9" resp="#CH" modified="2025-09-16T00:22:27.289+09:00" resp-change="#CH">形氣相得者，</seg>
                    <seg xml:id="KR3e0001_tls_020-3a.7" modified="2025-09-16T00:23:00.848+09:00" resp-change="#CH">危<c n="。"/>形瘦脈大<c n="，"/>
                    </seg>
                    <seg xml:id="KR3e0001_tls_020-3a.6" modified="2025-09-16T00:23:05.259+09:00" resp-change="#CH">少氣不足以息者<c n="，"/>
                    </seg>
                    <seg xml:id="KR3e0001_tls_020-3a.40" modified="2025-09-16T00:26:58.619+09:00" resp-change="#CH">死<c n="。"/>是以脫肉身不去者<c n="，"/>
                    </seg>
                    <seg xml:id="KR3e0001_tls_020-3a.39" modified="2025-09-16T00:27:08.074+09:00" resp-change="#CH">彈之不應者<c n="，"/>
                    </seg>
                    <seg xml:id="KR3e0001_tls_020-3a.41" modified="2025-09-16T00:27:15.555+09:00" resp-change="#CH">死<c n="。"/>中部乍踈乍數者<c n="，"/>
                    </seg>
                    <seg xml:id="KR3e0001_tls_020-3a.40" resp="#CH" modified="2025-09-16T00:27:23.619+09:00" resp-change="#CH">是以脫肉身不去者，</seg>
                    <seg xml:id="KR3e0001_tls_020-3a.42" modified="2025-09-16T00:27:34.168+09:00" resp-change="#CH">死<c n="。"/>其脈代而鉤者<c n="，"/>
                    </seg>
                    <seg xml:id="KR3e0001_tls_020-3a.41" resp="#CH" modified="2025-09-16T00:27:36.505+09:00" resp-change="#CH">中部乍踈乍數者，</seg>
                    <seg xml:id="KR3e0001_tls_001-2a.5" modified="2025-09-19T00:15:20.055+09:00" resp-change="#CH">避之有時<c n="，"/>
                    </seg>
                    <seg xml:id="KR3e0001_tls_001-2a.7" modified="2025-09-19T00:15:40.459+09:00" resp-change="#CH">真氣從之<c n="，"/>
                    </seg>
                </p>
