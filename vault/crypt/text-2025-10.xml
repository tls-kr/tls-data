        <body>
            <div>
                <head>Items</head>
                <p xml:id="del-2025-10-start">
                    <seg type="T1" xml:id="KR1j0018_tls_001-p5575a.2.3" modified="2025-10-01T00:51:29.055+09:00" resp-change="#CH">
                        <g n="眵" type="shifted"/>
                        <g type="head" n="偶">【偶】</g>，同人也。</seg>
                    <seg xml:id="KR3a0002_tls_007-3a.30" modified="2025-10-03T00:21:19.812+09:00" resp-change="#CH">是持寵處身不厭之術也<c n="。"/>
                    </seg>
                    <seg xml:id="KR3j0194_tls_014-185a.17" modified="2025-10-14T22:28:55.628+09:00" resp-change="#CH">
                        <c n="』"/>
                        <c n="」"/>
                    </seg>
                    <seg xml:id="KR3j0194_tls_014-185a.16" modified="2025-10-14T22:29:02.695+09:00" resp-change="#CH">
                        <c n="『"/>夫已多乎道<c n="？"/>
                    </seg>
                    <seg xml:id="CH7x2046_CHANT_023-9a.5" modified="2025-10-18T19:40:23.935+09:00" resp-change="#CH">令自禁也<c n="，"/>
                    </seg>
                    <seg xml:id="CH7x2046_CHANT_023-9a.4" modified="2025-10-18T19:40:35.912+09:00" resp-change="#CH">出令而無所受<c n="，"/>
                    </seg>
                    <seg xml:id="CH7x2046_CHANT_023-9a.11" modified="2025-10-18T19:58:24.355+09:00" resp-change="#CH">故口可劫而使<c n="，"/>
                    </seg>
                    <seg xml:id="CH7x2046_CHANT_023-9a.12" modified="2025-10-18T19:59:27.844+09:00" resp-change="#CH">墨云<c n="："/>
                    </seg>
                    <seg xml:id="CH7x2046_CHANT_023-9a.11" resp="#CH" modified="2025-10-18T20:01:47.346+09:00" resp-change="#CH">故口可劫而使墨云：</seg>
                    <seg xml:id="CH7x2046_CHANT_023-11a.5" modified="2025-10-18T21:32:26.897+09:00" resp-change="#CH">物皆求於心<c n="。"/>
                    </seg>
                    <seg xml:id="CH7x2046_CHANT_023-11a.4" modified="2025-10-18T21:32:38.86+09:00" resp-change="#CH">眾智之要<c n="，"/>
                    </seg>
                    <seg xml:id="CH7x2046_CHANT_037-2a.2" modified="2025-10-19T21:16:45.534+09:00" resp-change="#CH">作法五經<c n="，"/>運之天地<c n="，"/>稽之圖象<c n="，"/>質於三王<c n="，"/>施之四</seg>
                    <seg xml:id="CH7x2046_CHANT_037-2a.3" modified="2025-10-19T21:18:09.999+09:00" resp-change="#CH">海也<c n="。"/>
                    </seg>
                    <seg xml:id="CH7x2046_CHANT_037-2a.8" modified="2025-10-19T21:21:43.916+09:00" resp-change="#CH">雨<c n="，"/>河潤千里者也<c n="，"/>讚曰<c n="："/>
                        <c n="「"/>性靈鎔匠<c n="，"/>文章奧府<c n="。"/>淵哉鑠乎<c n="，"/>
                    </seg>
                    <seg xml:id="CH7x2046_CHANT_037-2a.7" modified="2025-10-19T21:23:15.794+09:00" resp-change="#CH">春秋五例<c n="，"/>義既極乎情性<c n="，"/>辭亦匠於文理<c n="，"/>可謂太山徧</seg>
                    <seg xml:id="CH7x2046_CHANT_037-2a.8" resp="#CH" modified="2025-10-19T21:23:33.437+09:00" resp-change="#CH">讚曰： 「性靈鎔匠，文章奧府。淵哉鑠乎，</seg>
                    <seg xml:id="CH7x2046_CHANT_037-2a.9" modified="2025-10-19T21:23:37.823+09:00" resp-change="#CH">群言之祖<c n="。"/>
                        <c n="」"/>
                    </seg>
                    <seg xml:id="CH7x2046_CHANT_019-192a.3" modified="2025-10-20T21:17:59.268+09:00" resp-change="#CH">鑒</seg>
                    <seg xml:id="CH7x2046_CHANT_019-192a.2" modified="2025-10-20T21:18:02.6+09:00" resp-change="#CH">郗司空</seg>
                    <seg xml:id="CH7x2046_CHANT_019-192a.12" modified="2025-10-20T21:23:07.949+09:00" resp-change="#CH">
                        <c n="？"/>王曰<c n="："/>
                    </seg>
                    <seg xml:id="CH7x2046_CHANT_019-192a.8" modified="2025-10-20T21:24:07.041+09:00" resp-change="#CH">惔</seg>
                    <seg xml:id="CH7x2046_CHANT_019-192a.7" modified="2025-10-20T21:24:18.622+09:00" resp-change="#CH">王右軍向劉尹</seg>
                    <seg xml:id="CH7x2046_CHANT_019-192a.11" modified="2025-10-20T21:24:42.286+09:00" resp-change="#CH">愔</seg>
                    <seg xml:id="CH7x2046_CHANT_019-192a.10" modified="2025-10-20T21:24:53.935+09:00" resp-change="#CH">劉問何如方回</seg>
                    <seg xml:id="KR3j0015_CH7x2006_004-4a.858" modified="2025-10-22T03:21:08.194+09:00" resp-change="#CH">右<c n="，"/>
                    </seg>
                    <seg xml:id="KR3j0015_CH7x2006_004-4a.827" modified="2025-10-22T03:24:59.587+09:00" resp-change="#CH">譥<c n="，"/>
                    </seg>
                    <seg xml:id="KR3j0015_CH7x2006_004-4a.826" modified="2025-10-22T03:25:06.646+09:00" resp-change="#CH">及譥者為之</seg>
                    <seg xml:id="KR3j0015_CH7x2006_004-4a.859" modified="2025-10-22T04:47:54.143+09:00" resp-change="#CH">信也<c n="。"/>
                        <c n="；"/>
                    </seg>
                    <seg xml:id="KR3j0015_CH7x2006_002-5a.293" modified="2025-10-22T17:14:21.205+09:00" resp-change="#CH">忠也<c n="。"/>
                        <c n="。"/>
                        <c n="」"/>
                    </seg>
                    <seg xml:id="KR3c0005_tls_023-29a.5" modified="2025-10-23T11:57:36.726+09:00" resp-change="#chris">
                        <c n="「"/>是其貫將滿<c n="。"/>
                        <c n="」"/>
                        <c n="："/>
                    </seg>
                    <seg xml:id="KR3c0005_tls_023-29a.7" modified="2025-10-23T11:57:51.525+09:00" resp-change="#chris">子姑待之<c n="。"/>
                        <c n="」"/>
                    </seg>
                    <seg xml:id="KR3c0005_tls_023-29a.6" modified="2025-10-23T11:58:04.763+09:00" resp-change="#chris" change="deletion">
                        <c n="「"/>矣<c n="，"/> 〓<c n="#"/>
                    </seg>
                    <seg xml:id="KR3c0005_tls_023-29a.5" resp="#chris" modified="2025-10-23T11:58:50.1+09:00" resp-change="#chris">「是其貫將滿矣。 」 ：</seg>
                    <seg xml:id="KR3c0005_tls_023-29a.7" resp="#chris" modified="2025-10-23T11:58:55.638+09:00" resp-change="#chris">「子姑待之。 」</seg>
                </p>
