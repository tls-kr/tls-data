                <p xml:id="del-2025-08-start">
                    <seg xml:id="KR3j0010_tls_013-27a.3" modified="2025-08-13T02:49:58.014+09:00" resp-change="#CH">世主之所亂惑也<c n="；"/>
                    </seg>
                    <seg xml:id="KR1e0008_tls_009-241a.5" modified="2025-08-18T15:49:55.094+09:00" resp-change="#CH">其日何也<c n="？"/>
                    </seg>
                    <seg xml:id="KR1e0008_tls_009-243a.3" modified="2025-08-18T15:50:20.356+09:00" resp-change="#CH">日歸<c n="，"/>
                    </seg>
                    <seg xml:id="KR5c0386_tls_007-12a.13" modified="2025-08-28T21:52:02.341+09:00" resp-change="#CH">醫門多疾。</seg>
                    <seg xml:id="KR5c0386_tls_007-51a.30" modified="2025-08-28T22:57:41.315+09:00" resp-change="#CH">）崔譔札或作禮，</seg>
                    <seg xml:id="KR5c0386_tls_007-51a.29" modified="2025-08-28T22:58:06.256+09:00" resp-change="#CH">亦札之訛。</seg>
                    <seg xml:id="KR5c0386_tls_007-51a.34" modified="2025-08-28T22:58:23.605+09:00" resp-change="#CH">）</seg>
                    <seg xml:id="KR5c0386_tls_007-51a.33" modified="2025-08-28T22:58:37.649+09:00" resp-change="#CH">禮亦為札之訛。</seg>
                    <seg xml:id="KR5c0386_tls_007-1b.21" modified="2025-08-30T05:08:22.668+09:00" resp-change="#CH">』遷令勸成殆事【一０】，</seg>
                    <seg xml:id="KR5c0386_tls_007-1b.20" modified="2025-08-30T05:08:35.52+09:00" resp-change="#CH">過度益也【九】。</seg>
                    <seg xml:id="KR5c0386_tls_007-519a.14" modified="2025-08-31T00:49:09.891+09:00" resp-change="#CH">）</seg>
                    <seg xml:id="KR5c0386_tls_007-519a.13" modified="2025-08-31T00:49:19.848+09:00" resp-change="#CH">說見天下〔篇〕名山三百下。</seg>
                </p>
