  <entry level="2" title="一、溫病與傷寒、瘟疫，受症不同，治法亦異" first-seg="KR3eg019_jc_001-d9.d2.h1s1" last-seg="KR3eg019_jc_001-d9.d2.p2s203"/>
  <entry level="2" title="二、溫病要知源流，入手方可不錯" first-seg="KR3eg019_jc_001-d9.d3.h1s1" last-seg="KR3eg019_jc_001-d9.d3.p2s246"/>
  <entry level="2" title="三、伏邪有本無標，時邪有標無本" first-seg="KR3eg019_jc_001-d9.d4.h1s1" last-seg="KR3eg019_jc_001-d9.d4.p2s401"/>
  <entry level="2" title="四、治溫病，以三焦為主，以手太陰為始" first-seg="KR3eg019_jc_001-d9.d5.h1s1" last-seg="KR3eg019_jc_001-d9.d5.p2s166"/>
  <entry level="2" title="五、治溫病，須善用手厥陰之方，斯為妙手" first-seg="KR3eg019_jc_001-d9.d6.h1s1" last-seg="KR3eg019_jc_001-d9.d6.p2s141"/>
  <entry level="2" title="六、治溫病用藥，要知中病即已，切不可過" first-seg="KR3eg019_jc_001-d9.d7.h1s1" last-seg="KR3eg019_jc_001-d9.d7.p2s161"/>
  <entry level="2" title="七、治溫病，要知上焦心主強健，邪氣舍心胞而順傳中下者，虛先受也" first-seg="KR3eg019_jc_001-d9.d8.h1s1" last-seg="KR3eg019_jc_001-d9.d8.p2s124"/>
  <entry level="2" title="八、伏邪時邪多端，要辨大同小異" first-seg="KR3eg019_jc_001-d9.d9.h1s1" last-seg="KR3eg019_jc_001-d9.d9.p2s453"/>
  <entry level="2" title="九、治溫病要識寒極似熱、熱極似寒、虛極似實、實極似虛四症，方不亂言吉凶" first-seg="KR3eg019_jc_001-d9.d10.h1s1" last-seg="KR3eg019_jc_001-d9.d10.p2s223"/>
  <entry level="1" title="卷下" first-seg="KR3eg019_jc_003-d10.h1s1" last-seg="KR3eg019_jc_003-d10.d5.p2s65"/>
  <entry level="2" title="十、治溫病要辨得表裡、虛實、寒熱六字明白，然後用藥，方不差誤" first-seg="KR3eg019_jc_003-d10.d2.h1s1" last-seg="KR3eg019_jc_003-d10.d2.p90s20"/>
  <entry level="2" title="十一、治諸病不驗，宜乎反求諸已" first-seg="KR3eg019_jc_003-d10.d3.h1s1" last-seg="KR3eg019_jc_003-d10.d3.p2s72"/>
  <entry level="2" title="十二、治溫病要知正面察死，對面知生總訣" first-seg="KR3eg019_jc_003-d10.d4.h1s1" last-seg="KR3eg019_jc_003-d10.d4.p38s9"/>
  <entry level="2" title="十三、治溫病要知病欲愈及可解症" first-seg="KR3eg019_jc_003-d10.d5.h1s1" last-seg="KR3eg019_jc_003-d10.d5.p2s65"/>
