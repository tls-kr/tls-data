  <entry level="1" title="醫津一筏" first-seg="KR3er103_jc_000-d6.h2s1" last-seg="KR3er103_jc_000-d6.h2s1"/>
  <entry level="1" title="治病必求其本" first-seg="KR3er103_jc_000-d12.h2s1" last-seg="KR3er103_jc_000-d12.h2s1"/>
  <entry level="1" title="有者求之，無者求之，盛者責之，虛者責之" first-seg="KR3er103_jc_000-d78.h2s1" last-seg="KR3er103_jc_000-d78.h2s1"/>
  <entry level="1" title="疏其氣血，令其調達，而致和平" first-seg="KR3er103_jc_000-d192.h2s1" last-seg="KR3er103_jc_000-d192.h2s1"/>
  <entry level="1" title="適事爲故" first-seg="KR3er103_jc_000-d210.h2s1" last-seg="KR3er103_jc_000-d210.h2s1"/>
  <entry level="1" title="反佐以取之" first-seg="KR3er103_jc_000-d214.h2s1" last-seg="KR3er103_jc_000-d214.h2s1"/>
  <entry level="1" title="從少從多，觀其事也" first-seg="KR3er103_jc_000-d242.h2s1" last-seg="KR3er103_jc_000-d242.h2s1"/>
  <entry level="1" title="必伏其所主而先其所因" first-seg="KR3er103_jc_000-d256.h2s1" last-seg="KR3er103_jc_000-d256.h2s1"/>
  <entry level="1" title="寒之而熱者取之陰，熱之而寒者取之陽，各求其屬" first-seg="KR3er103_jc_000-d276.h2s1" last-seg="KR3er103_jc_000-d276.h2s1"/>
  <entry level="1" title="明知逆順，正行無間" first-seg="KR3er103_jc_000-d300.h2s1" last-seg="KR3er103_jc_000-d300.h2s1"/>
  <entry level="1" title="推本陰陽" first-seg="KR3er103_jc_000-d306.h2s1" last-seg="KR3er103_jc_000-d306.h2s1"/>
  <entry level="1" title="食養盡之，毋使過之，傷其正也" first-seg="KR3er103_jc_000-d324.h2s1" last-seg="KR3er103_jc_000-d324.h2s1"/>
  <entry level="1" title="微妙在脉不可不察" first-seg="KR3er103_jc_000-d342.h2s1" last-seg="KR3er103_jc_000-d342.h2s1"/>
  <entry level="1" title="必先歲氣，無伐天和" first-seg="KR3er103_jc_000-d372.h2s1" last-seg="KR3er103_jc_000-d372.h2s1"/>
  <entry level="1" title="有毒無毒，固宐常制矣" first-seg="KR3er103_jc_000-d390.h2s1" last-seg="KR3er103_jc_000-d390.h2s1"/>
