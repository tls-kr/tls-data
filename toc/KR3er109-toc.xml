  <entry level="3" title="息積　氣分病也。" first-seg="KR3er109_jc_014-d16.d3.d4.h1s1" last-seg="KR3er109_jc_014-d16.d3.d4.p2s1606"/>
  <entry level="1" title="卷十五" first-seg="KR3er109_jc_015-d17.h1s1" last-seg="KR3er109_jc_015-d17.d4.p2s1393"/>
