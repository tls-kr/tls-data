  <entry level="3" title="白虎歷節風　痛痹之一症也。以其痛循歷遍身百節，故曰歷節。" first-seg="KR3er109_jc_013-d15.d2.d4.h1s1" last-seg="KR3er109_jc_013-d15.d2.d4.p2s704"/>
  <entry level="2" title="麻木源流" first-seg="KR3er109_jc_013-d15.d3.h1s1" last-seg="KR3er109_jc_013-d15.d3.p2s555"/>
  <entry level="2" title="破傷風源流（痙痓）" first-seg="KR3er109_jc_013-d15.d4.h1s1" last-seg="KR3er109_jc_013-d15.d4.d4.p2s593"/>
  <entry level="3" title="痙痓　　風寒濕熱俱有病也。痙者，筋勁強直而不柔和。痓者，口噤而角弓反張。" first-seg="KR3er109_jc_013-d15.d4.d4.h1s1" last-seg="KR3er109_jc_013-d15.d4.d4.p2s593"/>
