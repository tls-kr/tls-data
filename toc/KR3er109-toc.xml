  <entry level="3" title="消癉　肝心腎三經之陰虛而生內熱病也。" first-seg="KR3er109_jc_017-d19.d3.d4.h1s1" last-seg="KR3er109_jc_017-d19.d3.d4.p4s74"/>
  <entry level="2" title="火病源流" first-seg="KR3er109_jc_017-d19.d4.h1s1" last-seg="KR3er109_jc_017-d19.d4.p2s1668"/>
