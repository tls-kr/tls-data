                    <seg xml:id="CH8x3403_CHANT_001-2a.2">
                        <line>毋敢伐材木山林及雍隄水。</line>
                        <tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="SHOULD" concept-id="uuid-d0fba9df-4d64-437e-a88e-9f848207a2ce" xml:id="uuid-bf919931-fe3e-4ff9-9199-31fe3e7ff9a4">
                            <link target="#CH8x3403_CHANT_001-2a.2 #uuid-b2b9ef75-4288-4ea9-928e-f7807f222f8b"/>
                            <tls:text>
                                <tls:srcline title="秦律十八種" target="#CH8x3403_CHANT_001-2a.2" pos="22">毋敢伐材木山林及雍隄水。</tls:srcline>
                                <tls:line title="Remnants of Ch'in Law" transl-id="CH8x3403-en-63b7a58d" src="Hulsewé">one should not venture to cut timber in the forests or block water courses. </tls:line>
                            </tls:text>
