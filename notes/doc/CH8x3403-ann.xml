                    <seg xml:id="CH8x3403_CHANT_001-1a.1">
                        <line>雨為湗，</line>
                        <tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="IF" concept-id="uuid-2d3d0b50-ba72-473d-9cda-a9db0cc81a52" xml:id="uuid-4dfaeeb1-b8e6-4b7c-baee-b1b8e67b7cde">
