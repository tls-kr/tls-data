                                <tls:srcline title="秦律十八種" target="#CH8x3403_CHANT_001-1a.1" pos="2">雨為湗，</tls:srcline>
                                <tls:line title="Remnants of Ch'in Law" transl-id="CH8x3403-en-63b7a58d" src="Hulsewé">Whenever the rain is beneficial</tls:line>
                            </tls:text>
