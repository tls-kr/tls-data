                <p xml:id="CH8x3403-start">
                    <seg xml:id="CH8x3403_CHANT_010-11a.5">
                        <line>非適罪殹而欲為冗邊五歲</line>
                        <tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="ACCUSE" concept-id="uuid-876bb1f3-4a64-44d4-a352-38216cb8f038" xml:id="uuid-372ef2e7-1cbd-4cb2-aef2-e71cbdecb2d9">
                            <link target="#CH8x3403_CHANT_010-11a.5 #uuid-73f59ded-e6ac-44fd-b59d-ede6acd4fda8"/>
                            <tls:text>
                                <tls:srcline title="秦律十八種" target="#CH8x3403_CHANT_010-11a.5" pos="1">非適罪殹而欲為冗邊五歲</tls:srcline>
                                <tls:line title="" transl-id="CH8x3403" src=""/>
                            </tls:text>
                            <form corresp="#uuid-deee6081-fe94-4412-a87d-ffa1aba4fb28" orig="">
                                <orth>適</orth>
                                <pron xml:lang="zh-Latn-x-pinyin">dí</pron>
                            </form>
                            <sense corresp="#uuid-73f59ded-e6ac-44fd-b59d-ede6acd4fda8">
                                <gramGrp>
                                    <pos>V</pos>
                                    <tls:syn-func corresp="#uuid-0bcf295a-0ea1-450f-8a23-bf9130c190ff">vtt(oN1.) N2</tls:syn-func>
                                </gramGrp>
                                <def>read tì accuse the contextually determinate N of N2</def>
                            </sense>
                            <tls:metadata resp="#CH" created="2022-12-01T18:49:57.796+09:00">
                                <respStmt>
                                    <resp>added</resp>
                                    <name notBefore="2022-12-01T18:49:57.796+09:00">CH</name>
                                </respStmt>
                            </tls:metadata>
                        </tls:ann>
                    </seg>
                    <seg xml:id="CH8x3403_CHANT_001-1a.1">
                        <line>雨為湗，</line>
                        <tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="IF" concept-id="uuid-2d3d0b50-ba72-473d-9cda-a9db0cc81a52" xml:id="uuid-4dfaeeb1-b8e6-4b7c-baee-b1b8e67b7cde">
                            <link target="#CH8x3403_CHANT_001-1a.1 #uuid-0d96a5d0-c7bc-4c81-a8d6-9fdc79e834c4"/>
                            <tls:text>
                                <tls:srcline title="秦律十八種" target="#CH8x3403_CHANT_001-1a.1" pos="2">雨為湗，</tls:srcline>
                                <tls:line title="Remnants of Ch'in Law" transl-id="CH8x3403-en-63b7a58d" src="Hulsewé">Whenever the rain is beneficial</tls:line>
                            </tls:text>
                            <form corresp="#uuid-7dd1780c-ee9b-4eaa-af63-c42cb57baf50" orig="">
                                <orth>為</orth>
                                <pron xml:lang="zh-Latn-x-pinyin">wéi</pron>
                            </form>
                            <sense corresp="#uuid-0d96a5d0-c7bc-4c81-a8d6-9fdc79e834c4">
                                <gramGrp>
                    <pos>V</pos>
  <tls:syn-func corresp="#uuid-ea3084d7-d6fa-4817-a40b-ca7cd6fdd5f7">vadV.postN:adS</tls:syn-func>
                </gramGrp>
                                <def>if ZGC: 秦為知之，必不救也。</def>
                            </sense>
                            <tls:metadata resp="#schwermann" created="2025-11-18T22:41:27.528+09:00">
                                <respStmt>
                                    <resp>added</resp>
                                    <name notBefore="2025-11-18T22:41:27.528+09:00">schwermann</name>
                                </respStmt>
                            </tls:metadata>
                        </tls:ann>
                    </seg>
                    <seg xml:id="CH8x3403_CHANT_001-2a.2">
                        <line>毋敢伐材木山林及雍隄水。</line>
                        <tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="SHOULD" concept-id="uuid-d0fba9df-4d64-437e-a88e-9f848207a2ce" xml:id="uuid-bf919931-fe3e-4ff9-9199-31fe3e7ff9a4">
                            <link target="#CH8x3403_CHANT_001-2a.2 #uuid-b2b9ef75-4288-4ea9-928e-f7807f222f8b"/>
                            <tls:text>
                                <tls:srcline title="秦律十八種" target="#CH8x3403_CHANT_001-2a.2" pos="22">毋敢伐材木山林及雍隄水。</tls:srcline>
                                <tls:line title="Remnants of Ch'in Law" transl-id="CH8x3403-en-63b7a58d" src="Hulsewé">one should not venture to cut timber in the forests or block water courses. </tls:line>
                            </tls:text>
                            <form corresp="#uuid-56be8bf4-5f36-4e61-b33c-d6d9249ca440 #uuid-88746991-e994-4571-ba4d-df72ad0c3d63" orig="">
                                <orth>毋敢</orth>
                                <pron xml:lang="zh-Latn-x-pinyin">wú gǎn</pron>
                            </form>
                            <sense corresp="#uuid-b2b9ef75-4288-4ea9-928e-f7807f222f8b">
                                <gramGrp>
                    <pos>V</pos>
  <tls:syn-func corresp="#uuid-29b53c62-c07b-4ca5-a33f-539ea6586b8f">VPt[0]+V[0]</tls:syn-func>
                </gramGrp>
                                <def>don't you dare to V</def>
                            </sense>
                            <tls:metadata resp="#Maren.Ziegler-Bellenberg" created="2025-11-25T23:00:21.422+09:00">
                                <respStmt>
                                    <resp>added</resp>
                                    <name notBefore="2025-11-25T23:00:21.422+09:00">Maren.Ziegler-Bellenberg</name>
                                </respStmt>
                            </tls:metadata>
                        </tls:ann>
                    </seg>
                    <seg xml:id="CH8x3403_CHANT_001-2a.6">
                        <line>麛𠨫鷇，</line>
                        <tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="ANIMAL" concept-id="uuid-14a4e830-0ab6-47b9-94da-c725be1f1ac5" xml:id="uuid-f4a7dc72-3cbe-4f66-a7dc-723cbe3f66d9">
                            <link target="#CH8x3403_CHANT_001-2a.6 #uuid-e9962e69-5571-4a7b-962e-695571aa7be9"/>
                            <tls:text>
                                <tls:srcline title="秦律十八種" target="#CH8x3403_CHANT_001-2a.6" pos="1">麛𠨫鷇，</tls:srcline>
                                <tls:line title="Rechtsdokumente von Shuihudi" transl-id="CH8x3403-de-51efa271" src="TLS Project">Jungtiere zu fangen oder Eier und Nestlinge zu entnehmen</tls:line>
                            </tls:text>
                            <form corresp="#uuid-61ac3892-9b18-4cfd-9d5e-26e4af3e6fed" orig="">
                                <orth>麛</orth>
                                <pron xml:lang="zh-Latn-x-pinyin">mí</pron>
                            </form>
                            <sense corresp="#uuid-e9962e69-5571-4a7b-962e-695571aa7be9">
                                <gramGrp>
                                    <pos>N</pos>
                                    <tls:syn-func corresp="#uuid-8717712d-14a4-4ae2-be7a-6e18e61d929b">n</tls:syn-func>
                                </gramGrp>
                                <def>young animal</def>
                            </sense>
                            <tls:metadata resp="#schwermann" created="2025-12-02T22:25:39.975+09:00">
                                <respStmt>
                                    <resp>added</resp>
                                    <name notBefore="2025-12-02T22:25:39.975+09:00">schwermann</name>
                                </respStmt>
                            </tls:metadata>
                        </tls:ann>
                    </seg>
                    <seg xml:id="CH8x3403_CHANT_001-2a.8">
                        <line>置穽罔，</line>
                        <tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="TRAP" concept-id="uuid-21e54e28-946b-4cd7-9293-c8784a3174c7" xml:id="uuid-3b2c0c84-ab1d-402e-ac0c-84ab1d902e4d">
                            <link target="#CH8x3403_CHANT_001-2a.8 #uuid-6cc9eba6-3336-4499-89eb-a63336149947"/>
                            <tls:text>
                                <tls:srcline title="秦律十八種" target="#CH8x3403_CHANT_001-2a.8" pos="23">置穽罔，</tls:srcline>
                                <tls:line title="Rechtsdokumente von Shuihudi" transl-id="CH8x3403-de-51efa271" src="TLS Project">und Fallen und Netze aufzustellen.</tls:line>
                            </tls:text>
                            <form corresp="#uuid-4f62bf2a-9233-4eee-bb5a-e07b7d7b9e8d" orig="">
                                <orth>穽</orth>
                                <pron xml:lang="zh-Latn-x-pinyin">jìng</pron>
                            </form>
                            <sense corresp="#uuid-6cc9eba6-3336-4499-89eb-a63336149947">
                                <gramGrp>
                                    <pos>N</pos>
                                    <tls:syn-func corresp="#uuid-8717712d-14a4-4ae2-be7a-6e18e61d929b">n</tls:syn-func>
                                </gramGrp>
                                <def>trap, pitfall (for catching game)</def>
                            </sense>
                            <tls:metadata resp="#schwermann" created="2025-12-02T22:33:43.291+09:00">
                                <respStmt>
                                    <resp>added</resp>
                                    <name notBefore="2025-12-02T22:33:43.291+09:00">schwermann</name>
                                </respStmt>
                            </tls:metadata>
                        </tls:ann>
                    </seg>
                    <seg xml:id="CH8x3403_CHANT_001-2a.9">
                        <line>到七月而縱之。</line>
                        <tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="UNTIL" concept-id="uuid-e0ba8b6b-8c62-4279-9a06-f4611be42800" xml:id="uuid-3f73d45f-7738-4706-b3d4-5f773807062c">
                            <link target="#CH8x3403_CHANT_001-2a.9 #uuid-e133c31d-19f6-49ba-89b7-b38574e45154"/>
                            <tls:text>
                                <tls:srcline title="秦律十八種" target="#CH8x3403_CHANT_001-2a.9" pos="22">到七月而縱之。</tls:srcline>
                                <tls:line title="Rechtsdokumente von Shuihudi" transl-id="CH8x3403-de-51efa271" src="TLS Project">Zum siebten Monat hebe man (diese Vorschrift) auf.</tls:line>
                            </tls:text>
                            <form corresp="#uuid-60f400c0-1838-44e8-b9eb-b24481e4c21e" orig="">
                                <orth>到</orth>
                                <pron xml:lang="zh-Latn-x-pinyin">dào</pron>
                            </form>
                            <sense corresp="#uuid-e133c31d-19f6-49ba-89b7-b38574e45154">
                                <gramGrp>
                    <pos>V</pos>
  <tls:syn-func corresp="#uuid-feca8afb-ad1c-4d64-b883-7cdc85073e63">vt0.+prep+N:adV</tls:syn-func>
  <tls:sem-feat corresp="#uuid-dd37c44b-5a41-45e6-a045-090d47ae4923">time</tls:sem-feat>
                    <usg type="warring-states-currency">2</usg>
                </gramGrp>
                                <def>down to, until</def>
                            </sense>
                            <tls:metadata resp="#schwermann" created="2025-12-02T22:44:36.385+09:00">
                                <respStmt>
                                    <resp>added</resp>
                                    <name notBefore="2025-12-02T22:44:36.385+09:00">schwermann</name>
                                </respStmt>
                            </tls:metadata>
                        </tls:ann>
                    </seg>
                    <seg xml:id="CH8x3403_CHANT_001-3a.2">
                        <line>以其受田之數，</line>
                        <tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="RECEIVE" concept-id="uuid-178d0e00-bad0-4692-b215-571a38a096a8" xml:id="uuid-d41388c7-6688-4c61-9388-c766889c6113">
                            <link target="#CH8x3403_CHANT_001-3a.2 #uuid-fc340f5f-7b7c-4fa8-a3f3-616bbda27f00"/>
                            <tls:text>
                                <tls:srcline title="秦律十八種" target="#CH8x3403_CHANT_001-3a.2" pos="24">以其受田之數，</tls:srcline>
                                <tls:line title="Remnants of Ch'in Law" transl-id="CH8x3403-en-63b7a58d" src="Hulsewé">is to be done according to the number of fields bestowed.</tls:line>
                            </tls:text>
                            <form corresp="#uuid-7956102e-4f68-4cd7-b24c-33aed9e56072" orig="">
                                <orth>受</orth>
                                <pron xml:lang="zh-Latn-x-pinyin">shòu</pron>
                            </form>
                            <sense corresp="#uuid-fc340f5f-7b7c-4fa8-a3f3-616bbda27f00">
                                <gramGrp>
                    <pos>V</pos>
  <tls:syn-func corresp="#uuid-fbfb2371-2537-4a99-a876-41b15ec2463c">vtoN</tls:syn-func>
  <tls:sem-feat corresp="#uuid-988c2bcf-3cdd-4b9e-b8a4-615fe3f7f81e">passive</tls:sem-feat>
                </gramGrp>
                                <def>be received</def>
                            </sense>
                            <tls:metadata resp="#matejkas" created="2025-12-08T23:26:58.46+09:00">
                                <respStmt>
                                    <resp>added</resp>
                                    <name notBefore="2025-12-08T23:26:58.46+09:00">matejkas</name>
                                </respStmt>
                            </tls:metadata>
                        </tls:ann>
                    </seg>
                </p>
            </div>
