t><tls:srcline title="白虎通" target="#KR3j0023_tls_002-100a.6" pos="2">必擇天下美號</tls:srcline><tls:line title="" transl-id="KR3j0023" src=""/></tls:text><form corresp="#uuid-43e0256e-579f-43ab-ab11-d70174151708 #uuid-e2bc8c65-246b-4b87-bf92-9a624cdbcea7" orig=""><orth>天下</orth><pron xml:lang="zh-Latn-x-pinyin">tiān xià</pron></form><sense corresp="#uuid-9089f841-fd10-4297-89f8-41fd109297a2"><gramGrp><pos>N</pos><tls:syn-func corresp="#uuid-778943ef-d700-4189-8943-efd7008189cd">NPad.VadN</tls:syn-func><tls:sem-feat corresp="#uuid-0b8a684c-8893-4f48-8bf5-95250a8cbdc1">superlative</tls:sem-feat></gramGrp><def>the most Vs of the Ns in the world</def></sense><tls:metadata resp="#CH" created="2024-05-06T17:15:46.002+09:00"><respStmt><resp>added</resp><name notBefore="2024-05-06T17:15:46.002+09:00">CH</name></respStmt></tls:metadata></tls:ann></seg><seg xml:id="KR3j0023_tls_012-615a.8"><line>幸其覺悟也</line><tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="HOPE" concept-id="uuid-526a1682-7cfe-4e61-8aa8-c0df89af5120" xml:id="uuid-306b873f-bbc0-45d2-ab87-3fbbc085d28c"><link target="#KR3j0023_tls_012-615a.8 #uuid-8aad7bf7-4acb-418f-a942-ce88eb58c79a"/><tls:text><tls:srcline title="白虎通" target="#KR3j0023_tls_012-615a.8" pos="0">幸其覺悟也</tls:srcline><tls:line title="" transl-id="KR3j0023" src=""/></tls:text><form corresp="#uuid-e9fdef65-e690-4992-8359-89797217f567" orig=""><orth>幸</orth><pron xml:lang="zh-Latn-x-pinyin">xìng</pron></form><sense corresp="#uuid-8aad7bf7-4acb-418f-a942-ce88eb58c79a"><gramGrp>
                    <pos>V</pos>
  <tls:syn-func corresp="#uuid-0dd4edc0-7e8b-4e1b-b3e9-677c0faa3790">vtoNab{S}</tls:syn-func>
                </gramGrp><def resp="#CH" updated="2024-06-23T22:18:15.103+09:00">hope for the situation S by chance to arise</def></sense><tls:metadata resp="#CH" created="2024-06-24T03:38:55.179+09:00"><respStmt><resp>added</resp><name notBefore="2024-06-24T03:38:55.179+09:00">CH</name></respStmt></tls:metadata></tls:ann></seg><seg xml:id="KR3j0023_tls_012-593a.5"><line>冀君用其言耳</line><tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="HOPE" concept-id="uuid-526a1682-7cfe-4e61-8aa8-c0df89af5120" xml:id="uuid-f393e9a6-e10a-489e-93e9-a6e10a389e8f"><link target="#KR3j0023_tls_012-593a.5 #uuid-992ab2e3-7ec5-495c-96f3-a9c330e51375"/><tls:text><tls:srcline title="白虎通" target="#KR3j0023_tls_012-593a.5" pos="0">冀君用其言耳</tls:srcline><tls:line title="" transl-id="KR3j0023" src=""/></tls:text><form corresp="#uuid-61a8b1ce-8dd9-4fac-b2b4-ce006a6152ac" orig=""><orth>冀</orth><pron xml:lang="zh-Latn-x-pinyin">jì</pron></form><sense corresp="#uuid-992ab2e3-7ec5-495c-96f3-a9c330e51375"><gramGrp>
                    <pos>V</pos>
  <tls:syn-func corresp="#uuid-ccee9f93-d493-43f0-b41f-64aa72876a47">vtoS</tls:syn-func>
                </gramGrp><def resp="#CH" updated="2024-06-24T03:43:59.099+09:00">hope (diffidently) that S (where S may have an implicit subject, but that subject is not the hoper)</def></sense><tls:metadata resp="#CH" created="2024-06-24T03:44:00.953+09:00"><respStmt><resp>added</resp><name notBefore="2024-06-24T03:44:00.953+09:00">CH</name></respStmt></tls:metadata></tls:ann></seg><seg xml:id="KR3j0023_tls_009-460a.1"><line>水火不可加人功為用，</line><tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="CONTRARY" concept-id="uuid-3c29b8da-f85a-408f-98cf-fb78991751d5" xml:id="uuid-86a924bf-1eed-4dac-a924-bf1eed9dac45"><link target="#KR3j0023_tls_009-460a.1 #uuid-9c2d50c7-7eec-42b0-8129-ba6ab65e3894"/><tls:text><tls:srcline title="白虎通" target="#KR3j0023_tls_009-460a.1" pos="1">水火不可加人功為用，</tls:srcline><tls:line title="白虎通(en)" transl-id="KR3j0023" src="Tjan Tjoe Som">Why is it that water and fire cannot be of use by applying man's skill to them, </tls:line></tls:text><form corresp="#uuid-79a2ca70-d10b-42f5-b33d-4a27810b39dc #uuid-843121ff-f778-4be2-a643-71a2a1dc6acb" orig=""><orth>水火</orth><pron xml:lang="zh-Latn-x-pinyin">shuǐ huǒ</pron></form><sense corresp="#uuid-9c2d50c7-7eec-42b0-8129-ba6ab65e3894"><gramGrp>
                    <pos>V</pos>
  <tls:syn-func corresp="#uuid-091af450-64e0-4b82-98a2-84d0444b6d19">VPi</tls:syn-func>
                    <usg type="warring-states-currency">0</usg>
                </gramGrp><def>post-Han, Ming: be like fire and water, be practically quite incompatible with each other</def></sense><tls:metadata resp="#andreini" created="2025-09-24T01:49:18.853+09:00"><respStmt><resp>added</resp><name notBefore="2025-09-24T01:49:18.853+09:00">andreini</name></respStmt></tls:metadata></tls:ann></seg><seg xml:id="KR3j0023_tls_033-1109a.5"><line>王者之子稱王子，</line><tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="GENITIVE PARTICLES" concept-id="uuid-8ffa4531-1f93-473b-b468-7d0cf9390af1" xml:id="uuid-721679a1-59ba-40ff-9679-a159ba00ff14"><link target="#KR3j0023_tls_033-1109a.5 #uuid-1c76d26c-2036-41d9-a9d5-e39a4c58285f"/><tls:text><tls:srcline title="白虎通" target="#KR3j0023_tls_033-1109a.5" pos="3">王者之子稱王子，</tls:srcline><tls:line title="白虎通(en)" transl-id="KR3j0023" src="Tjan Tjoe Som">The son of the King is called 'King's son' wáng-zǐ, </tls:line></tls:text><form corresp="#uuid-dd2ad4ab-7266-4ee9-a622-5790a96a6515" orig=""><orth>之</orth><pron xml:lang="zh-Latn-x-pinyin">zhī</pron></form><sense corresp="#uuid-1c76d26c-2036-41d9-a9d5-e39a4c58285f"><gramGrp>
                    <pos>N</pos>
  <tls:syn-func corresp="#uuid-db3e24ed-d18b-454f-9f8f-47822681721b">npropostN1.adN2</tls:syn-func>
  <tls:sem-feat corresp="#uuid-eae5933e-44ca-4bb3-a593-3e44ca3bb31e">KINSHIP RELATION</tls:sem-feat>
                </gramGrp><def resp="#CH" updated="2026-03-23T21:29:13.971+09:00">N2=kin: 工匠之子 "son of a carpenter" 王之子 "sons of the king": NP2 designates an inalienable kinship relation which NP1 has to NP2 </def></sense><tls:metadata resp="#CH" created="2026-03-23T21:44:18.751+09:00" rating="1"><respStmt><resp>added</resp><name notBefore="2026-03-23T21:44:18.751+09:00">CH</name></respStmt><respStmt><name>CH</name><resp notBefore="2026-03-23T21:44:27.961+09:00">incr-rating</resp></respStmt></tls:metadata></tls:ann></seg><seg xml:id="KR3j0023_tls_002-98a.3"><line>必立天下之美號以表功自克，</line><tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="GENITIVE PARTICLES" concept-id="uuid-8ffa4531-1f93-473b-b468-7d0cf9390af1" xml:id="uuid-41f27e92-d3bb-4461-b27e-92d3bb946192"><link target="#KR3j0023_tls_002-98a.3 #uuid-18336b3b-1b7a-4f4f-b36b-3b1b7a5f4f88"/><tls:text><tls:srcline title="白虎通" target="#KR3j0023_tls_002-98a.3" pos="5">必立天下之美號以表功自克，</tls:srcline><tls:line title="白虎通(en)" transl-id="KR3j0023" src="Tjan Tjoe Som">he must create a beautiful appellation [expressing his possession] of all under Heaven, in order thereby to express his achievements and make himself illustrious234. </tls:line></tls:text><form corresp="#uuid-dd2ad4ab-7266-4ee9-a622-5790a96a6515" orig=""><orth>之</orth><pron xml:lang="zh-Latn-x-pinyin">zhī</pron></form><sense corresp="#uuid-18336b3b-1b7a-4f4f-b36b-3b1b7a5f4f88"><gramGrp><pos>N</pos><tls:syn-func corresp="#uuid-a796c759-72ce-4896-96c7-5972cee896b0">npropostNpl.ad:VadN</tls:syn-func><tls:sem-feat corresp="#uuid-dd1146bf-774b-48ef-9146-bf774be8efed">superlative "in Npl the most V of the Ns"</tls:sem-feat></gramGrp><def>天下之美人也“Mao Qiand and Xi Shi are the most beautiful people in the world"</def></sense><tls:metadata resp="#CH" created="2026-03-31T18:06:55.684+09:00"><respStmt><resp>added</resp><name notBefore="2026-03-31T18:06:55.684+09:00">CH</name></respStmt></tls:metadata></tls:ann></seg><seg xml:id="KR3j0023_tls_002-99a.3"><line>改制天下之大禮，</line><tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="GENITIVE PARTICLES" concept-id="uuid-8ffa4531-1f93-473b-b468-7d0cf9390af1" xml:id="uuid-0f199b1a-60ba-4b92-999b-1a60ba3b9249"><link target="#KR3j0023_tls_002-99a.3 #uuid-18336b3b-1b7a-4f4f-b36b-3b1b7a5f4f88"/><tls:text><tls:srcline title="白虎通" target="#KR3j0023_tls_002-99a.3" pos="5">改制天下之大禮，</tls:srcline><tls:line title="白虎通(en)" transl-id="KR3j0023" src="Tjan Tjoe Som">[So] they changed the institutions and created a great appellation236 [expressing their possession] of all under Heaven </tls:line></tls:text><form corresp="#uuid-dd2ad4ab-7266-4ee9-a622-5790a96a6515" orig=""><orth>之</orth><pron xml:lang="zh-Latn-x-pinyin">zhī</pron></form><sense corresp="#uuid-18336b3b-1b7a-4f4f-b36b-3b1b7a5f4f88"><gramGrp><pos>N</pos><tls:syn-func corresp="#uuid-a796c759-72ce-4896-96c7-5972cee896b0">npropostNpl.ad:VadN</tls:syn-func><tls:sem-feat corresp="#uuid-dd1146bf-774b-48ef-9146-bf774be8efed">superlative "in Npl the most V of the Ns"</tls:sem-feat></gramGrp><def>天下之美人也“Mao Qiand and Xi Shi are the most beautiful people in the world"</def></sense><tls:metadata resp="#CH" created="2026-03-31T18:07:43.939+09:00"><respStmt><resp>added</resp><name notBefore="2026-03-31T18:07:43.939+09:00">CH</name></respStmt></tls:metadata></tls:ann></seg></p></div></body></text></TEI>