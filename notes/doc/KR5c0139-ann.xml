                    <pos>V</pos>
  <tls:syn-func corresp="#uuid-fed035db-e7bd-4d23-bd05-9698b26e38f9">vadN</tls:syn-func>
                </gramGrp><def>summarizing&gt; general, all-encompassing; abstract 總名</def></sense><tls:metadata resp="#CH" created="2026-02-24T19:23:59.972+09:00"><respStmt><resp>added</resp><name notBefore="2026-02-24T19:23:59.972+09:00">CH</name></respStmt></tls:metadata></tls:ann></seg></p></div></body></text></TEI>