                    <seg xml:id="T48n2025_CBETA_005-1143a0401.s1">
                        <line>夫學般若菩薩起大悲心發弘誓願。</line>
                    </seg>
                    <seg xml:id="T48n2025_CBETA_005-1143a0401.s12">
                        <line>正身端坐。</line>
                        <tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="SIT" concept-id="uuid-d20180cb-e413-46ea-b0f7-cc847c2423a8" xml:id="uuid-9f96e409-d57f-4f6b-96e4-09d57f5f6bd2">
                            <link target="#T48n2025_CBETA_005-1143a0401.s12 #uuid-a402056b-3a02-4df9-8f86-7f9fce00ee27"/>
                            <tls:text>
                                <tls:srcline title="勅修百丈清規" target="#T48n2025_CBETA_005-1143a0401.s12" pos="3">正身端坐。</tls:srcline>
                                <tls:line title="Principles of Seated Meditation" transl-id="T48n2025-en-f20f8b07" src="Carl Bielefeldt">then straighten your body and sit erect. Do not lean to the left or right, forward or backward. Keep your hips, back, neck, and head in line, making your posture like a stūpa. But do not strain your body upward too far, lest it cause your breathing to be forced and unsettled.</tls:line>
                            </tls:text>
                            <form corresp="#uuid-b0f78e9d-8436-4cbe-a110-9a39cac62d04 #uuid-f88c4755-7f5b-4f25-8190-8d5a961a2884" orig="">
                                <orth>端坐</orth>
                                <pron xml:lang="zh-Latn-x-pinyin">duān zuò</pron>
                            </form>
                            <sense corresp="#uuid-a402056b-3a02-4df9-8f86-7f9fce00ee27">
                                <gramGrp>
                    <pos>V</pos>
  <tls:syn-func corresp="#uuid-091af450-64e0-4b82-98a2-84d0444b6d19">VPi</tls:syn-func>
                </gramGrp>
                                <def>sit straight (as in meditation)</def>
                            </sense>
                            <tls:metadata resp="#Francisco" created="2025-05-09T19:08:09.496+09:00">
                                <respStmt>
                                    <resp>added</resp>
                                    <name notBefore="2025-05-09T19:08:09.496+09:00">Francisco</name>
                                </respStmt>
                            </tls:metadata>
                        </tls:ann>
                    </seg>
                    <seg xml:id="T48n2025_CBETA_005-1143a0401.s23">
