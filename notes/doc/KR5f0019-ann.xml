eg><seg xml:id="KR5f0019_tls_000-12a.147"><line>多謂劉向非聖人，</line></seg><seg xml:id="KR5f0019_tls_000-234a.34"><line>人人皆以糧少，</line><tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="ALL" concept-id="uuid-78fc2812-4bf3-4e0a-8efe-78907250d397" xml:id="uuid-b89af4fe-c147-4604-9af4-fec14736040b"><link target="#KR5f0019_tls_000-234a.34 #uuid-1aafba81-2e6f-4d54-afba-812e6f3d54cc"/><tls:text><tls:srcline title="抱朴子" target="#KR5f0019_tls_000-234a.34" pos="1">人人皆以糧少，</tls:srcline><tls:line title="Translation of 抱朴子內篇 into (English)" transl-id="KR5f0019-en-8927dfc8" src="AI - Gemini">Everyone was concerned about having little food.</tls:line></tls:text><form corresp="#uuid-21fa0930-1ebd-4609-9c0d-ef7ef7a2723f #uuid-21fa0930-1ebd-4609-9c0d-ef7ef7a2723f" orig=""><orth>人人</orth><pron xml:lang="zh-Latn-x-pinyin">rén rén</pron></form><sense corresp="#uuid-1aafba81-2e6f-4d54-afba-812e6f3d54cc"><gramGrp><pos>N</pos><tls:syn-func corresp="#uuid-a8e89bab-49e1-4426-b230-0ec7887fd8b4">NP</tls:syn-func></gramGrp><def>Everybody</def></sense><tls:metadata resp="#CH" created="2025-09-15T03:32:49.689+09:00"><respStmt><resp>added</resp><name notBefore="2025-09-15T03:32:49.689+09:00">CH</name></respStmt></tls:metadata></tls:ann></seg><seg xml:id="KR5f0019_tls_000-214a.24"><line>而人得活。</line><tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="PERSIST" concept-id="uuid-5af4ba44-87c3-44c6-97d9-6ef94667b06f" xml:id="uuid-bb7734a6-6b81-4f8c-b734-a66b81df8cb6"><link target="#KR5f0019_tls_000-214a.24 #uuid-a051632d-5fc4-4f71-8e99-0d4ddca2a204"/><tls:text><tls:srcline title="抱朴子" target="#KR5f0019_tls_000-214a.24" pos="4">而人得活。</tls:srcline><tls:line title="Translation of 抱朴子內篇 into (English)" transl-id="KR5f0019-en-8927dfc8" src="AI - Gemini">and the person will survive.</tls:line></tls:text><form corresp="#uuid-6c6d8116-284d-45ef-9d58-10b8746609eb" orig=""><orth>活</orth><pron xml:lang="zh-Latn-x-pinyin">huó</pron></form><sense corresp="#uuid-a051632d-5fc4-4f71-8e99-0d4ddca2a204"><gramGrp>
                    <pos>V</pos>
  <tls:syn-func corresp="#uuid-c20780b3-41f9-491b-bb61-a269c1c4b48f">vi</tls:syn-func>
  <tls:sem-feat corresp="#uuid-da12432d-7ed6-4864-b7e5-4bb8eafe44b4">process</tls:sem-feat>
                    <usg type="warring-states-currency">5</usg>
                </gramGrp><def>survive</def></sense><tls:metadata resp="#CH" created="2025-09-15T04:11:01.278+09:00"><respStmt><resp>added</resp><name notBefore="2025-09-15T04:11:01.278+09:00">CH</name></respStmt></tls:metadata></tls:ann></seg><seg xml:id="KR5f0019_tls_000-192a.6"><line>白者，</line><tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="WHITE" concept-id="uuid-98e9c5fd-7b72-4718-8205-2d7eda251c25" xml:id="uuid-148a93d5-ca5c-4e53-8a93-d5ca5c1e53ea"><link target="#KR5f0019_tls_000-192a.6 #uuid-e5839179-cdaa-419f-b41b-08ca10b7fc16"/><tls:text><tls:srcline title="抱朴子" target="#KR5f0019_tls_000-192a.6" pos="1">白者，</tls:srcline><tls:line title="Translation of 抱朴子內篇 into (English)" transl-id="KR5f0019-en-8927dfc8" src="AI - Gemini">White</tls:line></tls:text><form corresp="#uuid-7c026c66-9781-474b-b1ca-8e6ae50db29a" orig=""><orth>白</orth><pron xml:lang="zh-Latn-x-pinyin">bái</pron></form><sense corresp="#uuid-e5839179-cdaa-419f-b41b-08ca10b7fc16"><gramGrp>
                    <pos>V</pos>
  <tls:syn-func corresp="#uuid-c20780b3-41f9-491b-bb61-a269c1c4b48f">vi</tls:syn-func>
                    <usg type="warring-states-currency">4</usg>
                </gramGrp><def resp="#CH" updated="2024-02-17T00:25:29.266+09:00">be white; of swords: blank, i.e. drawn; of hair: be grey</def></sense><tls:metadata resp="#CH" created="2025-09-15T05:03:41.684+09:00"><respStmt><resp>added</resp><name notBefore="2025-09-15T05:03:41.684+09:00">CH</name></respStmt></tls:metadata></tls:ann></seg><seg xml:id="KR5f0019_tls_000-181a.51"><line>往往有之。」</line><tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="OFTEN" concept-id="uuid-7f6b310e-3908-4735-9453-529445663919" xml:id="uuid-0f8eb263-3ae1-4ce7-8eb2-633ae12ce762"><link target="#KR5f0019_tls_000-181a.51 #uuid-29eb1c96-227f-439e-9437-c0230afc58ff"/><tls:text><tls:srcline title="抱朴子" target="#KR5f0019_tls_000-181a.51" pos="1">往往有之。」</tls:srcline><tls:line title="" transl-id="KR5f0019-en-8927dfc8" src=""/></tls:text><form corresp="#uuid-63559230-29cd-4108-8624-6acfe0f5954d #uuid-63559230-29cd-4108-8624-6acfe0f5954d" orig=""><orth>往往</orth><pron xml:lang="zh-Latn-x-pinyin">wǎng wǎng</pron></form><sense corresp="#uuid-29eb1c96-227f-439e-9437-c0230afc58ff"><gramGrp>
                    <pos/>
  <tls:syn-func corresp="#uuid-9aa5b1d9-fdb3-433e-8f17-04a2fb18b24e">v.red:adV</tls:syn-func>
                </gramGrp><def>often</def></sense><tls:metadata resp="#CH" created="2025-09-15T22:23:37.741+09:00"><respStmt><resp>added</resp><name notBefore="2025-09-15T22:23:37.741+09:00">CH</name></respStmt></tls:metadata></tls:ann></seg><seg xml:id="KR5f0019_tls_000-27a.5"><line>「有之。</line><tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="TRUE" concept-id="uuid-5dfd2084-459d-4bd3-9a20-ca0f2f78db51" xml:id="uuid-79a3bec4-d64a-4e74-a3be-c4d64a6e74df"><link target="#KR5f0019_tls_000-27a.5 #uuid-502269c0-61e6-4bf0-a269-c061e62bf05a"/><tls:text><tls:srcline title="抱朴子" target="#KR5f0019_tls_000-27a.5" pos="2">「有之。</tls:srcline><tls:line title="Translation of 抱朴子內篇 into (English)" transl-id="KR5f0019-en-8927dfc8" src="AI - Gemini">"It is so.</tls:line></tls:text><form corresp="#uuid-5ba72032-5f6c-406d-a1fc-05dc9395e991 #uuid-dd2ad4ab-7266-4ee9-a622-5790a96a6515" orig=""><orth>有之</orth><pron xml:lang="zh-Latn-x-pinyin">yǒu zhī</pron></form><sense corresp="#uuid-502269c0-61e6-4bf0-a269-c061e62bf05a"><gramGrp><pos>V</pos><tls:syn-func corresp="#uuid-293663a2-b459-4ea9-a147-fe1a5feb8a6b">VPi(0)</tls:syn-func></gramGrp><def>(that) is true</def></sense><tls:metadata resp="#CH" created="2025-11-07T01:45:12.617+09:00"><respStmt><resp>added</resp><name notBefore="2025-11-07T01:45:12.617+09:00">CH</name></respStmt></tls:metadata></tls:ann></seg><seg xml:id="KR5f0019_tls_000-245a.19"><line>如此果是異人也。」</line><tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="EXCELLENT" concept-id="uuid-ae257525-1a92-45db-8b05-d5f95447c246" xml:id="uuid-d36bc569-edfe-4fae-abc5-69edfebfae8a"><link target="#KR5f0019_tls_000-245a.19 #uuid-521478fa-15f5-4c3c-be7e-3f34e7f89c7f"/><tls:text><tls:srcline title="抱朴子" target="#KR5f0019_tls_000-245a.19" pos="5">如此果是異人也。」</tls:srcline><tls:line title="Translation of 抱朴子內篇 into (English)" transl-id="KR5f0019-en-8927dfc8" src="AI - Gemini">If this is so, he is indeed an extraordinary man."</tls:line></tls:text><form corresp="#uuid-2358b4e4-e373-45a4-ba89-da230502ff10" orig=""><orth>異</orth><pron xml:lang="zh-Latn-x-pinyin">yì</pron></form><sense corresp="#uuid-521478fa-15f5-4c3c-be7e-3f34e7f89c7f"><gramGrp>
                    <pos>V</pos>
  <tls:syn-func corresp="#uuid-fed035db-e7bd-4d23-bd05-9698b26e38f9">vadN</tls:syn-func>
                    <usg type="warring-states-currency">3</usg>
                </gramGrp><def resp="#CH" updated="2025-11-08T19:02:46.624+09:00">extraordinary; remarkable, outstanding, distinguished</def></sense><tls:metadata resp="#CH" created="2025-11-08T19:02:46.735+09:00"><respStmt><resp>added</resp><name notBefore="2025-11-08T19:02:46.735+09:00">CH</name></respStmt></tls:metadata></tls:ann></seg><seg xml:id="KR5f0019_tls_001-378a.80"><line>晏嬰謂杼為大不仁，</line></seg><seg xml:id="KR5f0019_tls_000-240a.96"><line>我曾在華陰山斷穀五十年，</line><tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="ABSTINENCE" concept-id="uuid-05bf014e-2f21-47af-9352-37b89e05e9d5" xml:id="uuid-5f9ae979-4611-435a-9ae9-794611d35adf"><link target="#KR5f0019_tls_000-240a.96 #uuid-75a2af7d-4da4-46da-a2af-7d4da4e6daa5"/><tls:text><tls:srcline title="抱朴子" target="#KR5f0019_tls_000-240a.96" pos="7">我曾在華陰山斷穀五十年，</tls:srcline><tls:line title="AI Output of 抱朴子 into English" transl-id="KR5f0019-en-e73a2114" src="Open AI">‘I once fasted from grain in the Huàyīn Mountains for fifty years,</tls:line></tls:text><form corresp="#uuid-1cdb3d34-31dc-4fd9-81a0-4f088c6bc318 #uuid-5dc3020c-77fc-413e-834e-3fa1184bf437" orig=""><orth>斷穀</orth><pron xml:lang="zh-Latn-x-pinyin">duàn gǔ</pron></form><sense corresp="#uuid-75a2af7d-4da4-46da-a2af-7d4da4e6daa5"><gramGrp><pos>V</pos><tls:syn-func corresp="#uuid-091af450-64e0-4b82-98a2-84d0444b6d19">VPi</tls:syn-func></gramGrp><def>abtstain from grain</def></sense><tls:metadata resp="#CH" created="2026-02-24T19:08:10.916+09:00"><respStmt><resp>added</resp><name notBefore="2026-02-24T19:08:10.916+09:00">CH</name></respStmt></tls:metadata></tls:ann></seg><seg xml:id="KR5f0019_tls_000-192a.399"><line>而更當齋戒辛苦，</line><tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="ABSTINENCE" concept-id="uuid-05bf014e-2f21-47af-9352-37b89e05e9d5" xml:id="uuid-b3a19eb4-a0c5-4bcd-a19e-b4a0c5abcd2b"><link target="#KR5f0019_tls_000-192a.399 #uuid-fc9543ce-843f-496b-9543-ce843f696b69"/><tls:text><tls:srcline title="抱朴子" target="#KR5f0019_tls_000-192a.399" pos="4">而更當齋戒辛苦，</tls:srcline><tls:line title="AI Output of 抱朴子 into English" transl-id="KR5f0019-en-e73a2114" src="Open AI">but abstinence and suffering are required,</tls:line></tls:text><form corresp="#uuid-c03ca3f9-ad68-44e9-b661-df11d6eb2f18 #uuid-b35a3dad-a45f-479f-a205-626b9ae7f802 #uuid-e08366c7-8cce-4745-9c82-50969681fbf7 #uuid-7a7bf008-b92c-4cfd-9432-508d2b35b026" orig=""><orth>齋戒辛苦</orth><pron xml:lang="zh-Latn-x-pinyin">zhāi jiè xīn kǔ</pron></form><sense corresp="#uuid-fc9543ce-843f-496b-9543-ce843f696b69"><gramGrp><pos>V</pos><tls:syn-func corresp="#uuid-091af450-64e0-4b82-98a2-84d0444b6d19">VPi</tls:syn-func></gramGrp><def>abstinence with self-imposed hard labour</def></sense><tls:metadata resp="#CH" created="2026-02-24T19:10:47.008+09:00"><respStmt><resp>added</resp><name notBefore="2026-02-24T19:10:47.008+09:00">CH</name></respStmt></tls:metadata></tls:ann></seg><seg xml:id="KR5f0019_tls_000-11a.10"><line>而淺識之徒，</line><tls:ann xmlns:tls="http://hxwd.org/ns/1.0" concept="SHALLOW" concept-id="uuid-9a55881b-7984-4567-aaa9-714e78d66931" xml:id="uuid-20102cc0-a9de-469b-902c-c0a9de469bb5"><link target="#KR5f0019_tls_000-11a.10 #uuid-0452f35a-517f-4a40-92f3-5a517fea40fe"/><tls:text><tls:srcline title="抱朴子" target="#KR5f0019_tls_000-11a.10" pos="2">而淺識之徒，</tls:srcline><tls:line title="AI Output of 抱朴子 into English" transl-id="KR5f0019-en-e73a2114" src="Open AI">Yet the shallow-minded crowd,</tls:line></tls:text><form corresp="#uuid-6c332f84-a3e1-44df-8c9b-4acf83836382" orig=""><orth>淺</orth><pron xml:lang="zh-Latn-x-pinyin">qiǎn</pron></form><sense corresp="#uuid-0452f35a-517f-4a40-92f3-5a517fea40fe"><gramGrp><pos>V</pos><tls:syn-func corresp="#uuid-fed035db-e7bd-4d23-bd05-9698b26e38f9">vadN</tls:syn-func><tls:sem-feat corresp="#uuid-c095dc00-e0a6-4d08-95dc-00e0a6cd0837">figured</tls:sem-feat></gramGrp><def>shallow</def></sense><tls:metadata resp="#CH" created="2026-03-10T03:11:57.202+09:00"><respStmt><resp>added</resp><name notBefore="2026-03-10T03:11:57.202+09:00">