                <p xml:id="CH7x2046-start">
                    <seg corresp="#CH7x2046_CHANT_001-61a.2" xml:lang="en" resp="#CH" modified="2025-10-16T22:03:33.899+09:00">characters in Heaven</seg>
                    <seg corresp="#CH7x2046_CHANT_023-13a.10" xml:lang="en" resp="#CH" modified="2025-10-17T17:22:15.67+09:00">focussing one's desires on one thing and stopping indulgence.</seg>
                    <seg corresp="#CH7x2046_CHANT_023-21a.13" xml:lang="en" resp="#CH" modified="2025-10-18T21:48:59.039+09:00">It is the Way that converges/assembles in themptiness.</seg>
                    <seg corresp="#CH7x2046_CHANT_023-40a.25" xml:lang="en" resp="#CH" modified="2025-10-19T19:16:13.247+09:00">same as above</seg>
                    <seg corresp="#CH7x2046_CHANT_019-14a.47" xml:lang="en" resp="#CH" modified="2025-10-19T23:47:46.747+09:00"/>
                    <seg corresp="#CH7x2046_CHANT_019-25a.5" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-20T02:54:45.408+09:00">Mào first married a Sūn woman,</seg>
                    <seg corresp="#CH7x2046_CHANT_019-52a.4" xml:lang="en" resp="#CH" modified="2025-10-20T03:47:15.479+09:00">sent someone to have him castrated</seg>
                    <seg corresp="#CH7x2046_CHANT_019-99a.11" xml:lang="en" resp="#CH" modified="2025-10-20T06:05:34.403+09:00">漢書</seg>
                    <seg corresp="#CH7x2046_CHANT_019-106a.8" xml:lang="en" resp="#CH" modified="2025-10-20T06:26:26.368+09:00">he was fearful of and kept his distance from those in power</seg>
                </p>
