   <text>
      <body>
         <div>
            <head>Translated parts</head>
            <p xml:id="CH2b1558-start">
            <seg corresp="#CH2b1558_CHANT_004-28a.1" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:08:43.022+09:00"/>
                    <seg corresp="#CH2b1558_CHANT_004-29a.1" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00"/>
                    <seg corresp="#CH2b1558_CHANT_004-29a.2" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">Letter on Wrestling the Red Ape</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.3" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">*Letter on Wrestling the Red Ape*</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.4" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">I unexpectedly dreamed of wrestling a red ape,</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.5" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">whose strength was greater than that of a *pi* and tiger.</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.6" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">It lasted for a long time, again and again.</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.7" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">I then looked at the heavens,</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.8" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">turned my back on the earth,</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.9" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">and faced the extreme;</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.10" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">it will surely be accurate.</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.11" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">But since I am not enlightened,</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.12" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">how can I not worry?</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.13" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">Is it auspicious?</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.14" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">Arrest me.</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.15" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">Is it inauspicious?</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.16" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">Please tell me in detail.</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.17" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">March,</seg>
                    <seg corresp="#CH2b1558_CHANT_004-29a.18" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00">Ruan Ji, writing to You Jun.</seg>
                    <seg corresp="#CH2b1558_CHANT_004-30a.1" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-05-07T10:11:17.943+09:00"/>
    
<seg corresp="#CH2b1558_CHANT_001-1a.1-h" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Scroll 1</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.1" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00"/>
                    <seg corresp="#CH2b1558_CHANT_001-1a.2" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Part 1</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.3" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">"Three Poems of Expressing My Aspirations"</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.4" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Tiāndì yīnyūn, (Heaven and earth are filled with vital energy,)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.5" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">yuán jīng dài xù. (The primordial essence succeeds in order.)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.6" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Qīngyáng yào líng, (Pure Yang shines brightly,)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.7" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">héfēng róngyǔ. (And the gentle breeze is leisurely.)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.8" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Míngrì yìng tiān, (The bright sun reflects in the sky,)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.9" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">gānlù bèi yǔ. (Sweet dew covers the universe.)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.10" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Wěngyù gāo sōng, (Luxuriant and dense are the tall pines,)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.11" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">yī nà cháng chǔ. (And graceful are the long shrubs.)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.12" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Cǎochóng āimíng, (Grass insects sadly chirp,)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.13" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">cānggēng zhèn yǔ. (And the oriole shakes its wings.)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.14" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Gǎn shí xīng sī, (Moved by the season, thoughts arise,)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.15" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">qǐ shǒu yán zhù. (I lift my head and stand for a long time.)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.16" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Yū hè dì cháo, (How glorious is the imperial court,)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.17" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Yī Héng zuò fǔ. (Yī Héng serves as the assistant.)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.18" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Cái fēi yǔnwén, (My talent is not for civil administration,)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.19" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">qì fēi jīngwǔ. (My ability is not for military affairs.)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.20" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Shì bǐ Yuán Xiāng, (I will go to the Yuán and Xiāng rivers,)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.21" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">tuō fēn yúfù. (And entrust myself to the role of a fisherman.)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.22" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Yōu zāi! (How leisurely!)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.23" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Yóu zāi! (How free!)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-1a.24" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Yuán jū yuán chǔ. (There I will reside, there I will live.)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-2a.1" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00"/>
                    <seg corresp="#CH2b1558_CHANT_001-2a.2" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Part 2</seg>
                    <seg corresp="#CH2b1558_CHANT_001-2a.3" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Yuè míng xīng xī, (The moon is bright, and the stars are few,)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-2a.4" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">tiān gāo qì hán. (The sky is high, and the air is cold.)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-2a.5" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Guì qí cuì jīng, (Cassia banners and emerald streamers,)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-2a.6" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">pèi yù míng luán. (Jade pendants tinkle like the mythical *luán* bird.)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-2a.7" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">Zhuó yīng lǐ quán, (I wash my tassels in the sweet spring,)</seg>
                    <seg corresp="#CH2b1558_CHANT_001-2a.8" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-07-14T11:26:25.923+09:00">bèi fú huì lán. (And wear fragrant orchids as clothing.)</seg>
                </p>
         </div>
