            <div>
                <head>Translated parts</head>
                <p xml:id="KR3ec025-start">
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s99" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">(When ground into pills with qīng dài</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s100" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">and zhū shā,</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s101" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">it treats evil heat in heart disease.)</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s102" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">Pig kidney</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s103" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">(For deficiency and damage to the heart and kidneys,</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s104" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">cook and eat it with shēn</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s105" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">and dāng guī.)</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s106" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">Hearts of the Six Domestic Animals</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s107" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">(For heart deficiency causing pain,</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s108" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">palpitations, fright, and disorientation.)</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s109" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">Zhèn meat</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s110" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">(For loss of heart due to fright,</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s111" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">make into jerky and eat.)</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s112" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">Human spirit</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s113" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">(Grind in water and drink,</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d46.p4s114" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">calms palpitations and manic running.)</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.h1s1" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">Mania and disorientation</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p2s1" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">(Due to fire,</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p2s2" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">phlegm,</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p2s3" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">and animal blood.)</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p4s1" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">[Clearing and Tranquilizing] [Herb Section] huáng lián,</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p4s2" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">Lán juice,</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p4s3" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">mài mén dōng,</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p4s4" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">jì nǐ,</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p4s5" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">yīn chén,</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p4s6" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">hǎi jīn shā</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p4s7" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">(All mainly treat mania due to cold damage.)</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p4s8" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">Wēi ruí,</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p4s9" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">zǐ shēn,</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p4s10" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">bái tóu wēng</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p4s11" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">(All mainly treat malarial madness.)</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p4s12" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">bái wēi</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p4s13" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">(For sudden wind-heat stroke,</seg>
                    <seg corresp="#KR3ec025_jc_003-d8.d2.d47.p4s14" xml:lang="en" resp="#gemini-2.0-flash" modified="2025-10-09T13:54:08.284+09:00">suddenly not recognizing people,</seg>
                </p>
