    <text>
        <body>
            <div>
                <head>Translated parts</head>
                <p xml:id="CH1e0879-start">
                    <seg corresp="#CH1e0879_CHANT_012-6a.3" xml:lang="en" resp="#CH" modified="2025-07-07T19:59:02.43+09:00">凡是事物一定有相合的•，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.4" xml:lang="en" resp="#CH" modified="2025-07-07T19:59:11.013+09:00">相合一定有上面，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.5" xml:lang="en" resp="#CH" modified="2025-07-07T19:59:15.459+09:00">一定有下面；</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.6" xml:lang="en" resp="#CH" modified="2025-07-07T19:59:21.96+09:00">一定有左邊，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.7" xml:lang="en" resp="#CH" modified="2025-07-07T19:59:24.676+09:00">一定有右邊； </seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.8" xml:lang="en" resp="#CH" modified="2025-07-07T19:59:29.227+09:00">一定有前面，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.9" xml:lang="en" resp="#CH" modified="2025-07-07T19:59:42.567+09:00">一定有後面； </seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.10" xml:lang="en" resp="#CH" modified="2025-07-07T20:00:16.346+09:00">一定有外表，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.11" xml:lang="en" resp="#CH" modified="2025-07-07T20:00:32.629+09:00">一定有裏面•，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.12" xml:lang="en" resp="#CH" modified="2025-07-07T20:00:38.772+09:00">有美好，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.13" xml:lang="en" resp="#CH" modified="2025-07-07T20:00:57+09:00">有順從，一定有違逆；</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.14" xml:lang="en" resp="#CH" modified="2025-07-07T20:01:01.712+09:00">有喜悅，一定有憤怒；</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.15" xml:lang="en" resp="#CH" modified="2025-07-07T20:01:29.354+09:00">有寒冷，一定有暑熱•，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.16" xml:lang="en" resp="#CH" modified="2025-07-07T20:01:36.003+09:00">有白天，一定有夜晚：</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.17" xml:lang="en" resp="#CH" modified="2025-07-07T20:02:09.388+09:00">這些都是互相耦合的。</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.18" xml:lang="en" resp="#CH" modified="2025-07-07T20:02:16.861+09:00">陰氣，是陽氣的匹偶，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.19" xml:lang="en" resp="#CH" modified="2025-07-07T20:02:19.72+09:00">妻子，是丈夫的匹偶，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.20" xml:lang="en" resp="#CH" modified="2025-07-07T20:02:22.553+09:00">兒子，是父親的匹偶，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.21" xml:lang="en" resp="#CH" modified="2025-07-07T20:02:26.725+09:00">臣子，是君主的匹偶，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.22" xml:lang="en" resp="#CH" modified="2025-07-07T20:02:32.574+09:00">事物都有匹偶，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.23" xml:lang="en" resp="#CH" modified="2025-07-07T20:03:04.733+09:00">而它們本身又有陰陽。</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.24" xml:lang="en" resp="#CH" modified="2025-07-07T20:03:13.877+09:00">陽跟陰合併，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.25" xml:lang="en" resp="#CH" modified="2025-07-07T20:03:25.066+09:00">陰跟陽合併，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.26" xml:lang="en" resp="#CH" modified="2025-07-07T20:03:31.646+09:00">丈夫跟妻子合併.</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.27" xml:lang="en" resp="#CH" modified="2025-07-07T20:03:34.416+09:00">妻子跟丈夫合併，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.28" xml:lang="en" resp="#CH" modified="2025-07-07T20:03:37.512+09:00">父親跟兒子合併，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.29" xml:lang="en" resp="#CH" modified="2025-07-07T20:03:41.356+09:00">兒子跟父親合併，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.30" xml:lang="en" resp="#CH" modified="2025-07-07T20:03:47.396+09:00">君主跟臣子合併，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.31" xml:lang="en" resp="#CH" modified="2025-07-07T20:03:50.977+09:00">臣子跟君主合併，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.32" xml:lang="en" resp="#CH" modified="2025-07-07T20:04:03.566+09:00">君臣、父子、夫婦間的意義，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.33" xml:lang="en" resp="#CH" modified="2025-07-07T20:04:10.436+09:00">都採取陰陽之間的道理。</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.34" xml:lang="en" resp="#CH" modified="2025-07-07T20:04:14.736+09:00">君主是陽，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.35" xml:lang="en" resp="#CH" modified="2025-07-07T20:04:19.15+09:00">臣子是陰，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.36" xml:lang="en" resp="#CH" modified="2025-07-07T20:04:22.432+09:00">父親是陽，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.37" xml:lang="en" resp="#CH" modified="2025-07-07T20:04:25.197+09:00">兒子是陰，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.38" xml:lang="en" resp="#CH" modified="2025-07-07T20:04:31.108+09:00">丈夫是陽.</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.39" xml:lang="en" resp="#CH" modified="2025-07-07T20:04:33.826+09:00">妻子是陰，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.40" xml:lang="en" resp="#CH" modified="2025-07-07T20:04:36.972+09:00">陰道不單獨行動，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.41" xml:lang="en" resp="#CH" modified="2025-07-07T20:05:06.34+09:00">開始的時候，不能單獨發起，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.42" xml:lang="en" resp="#CH" modified="2025-07-07T20:05:08.9+09:00">終結的時候，不能分享功勞，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.43" xml:lang="en" resp="#CH" modified="2025-07-07T20:05:33.782+09:00">有所兼併的意思。</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.44" xml:lang="en" resp="#CH" modified="2025-07-07T20:05:37.071+09:00">臣子的功勞跟君主合併.</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.45" xml:lang="en" resp="#CH" modified="2025-07-07T20:06:38.096+09:00">兒子的功勞跟父親合併，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.46" xml:lang="en" resp="#CH" modified="2025-07-07T20:06:42.582+09:00">妻子的功勞跟丈夫合併，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.47" xml:lang="en" resp="#CH" modified="2025-07-07T20:06:45.866+09:00">陰的功勞跟陽合併，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.48" xml:lang="en" resp="#CH" modified="2025-07-07T20:06:52.426+09:00">地的功勞跟天合併。</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.49" xml:lang="en" resp="#CH" modified="2025-07-07T20:06:55.211+09:00">有的往上擧拔，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.50" xml:lang="en" resp="#CH" modified="2025-07-07T20:07:01.393+09:00">有的往下壓抑，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.51" xml:lang="en" resp="#CH" modified="2025-07-07T20:07:06.316+09:00">有的屏退而往左，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.52" xml:lang="en" resp="#CH" modified="2025-07-07T20:07:09.175+09:00">有的牽引而往右，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.53" xml:lang="en" resp="#CH" modified="2025-07-07T20:07:12.699+09:00">有的親近而信任，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.54" xml:lang="en" resp="#CH" modified="2025-07-07T20:07:16.747+09:00">有的疏隔而遠離，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.55" xml:lang="en" resp="#CH" modified="2025-07-07T20:07:21.244+09:00">有的要一天天地增加，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.56" xml:lang="en" resp="#CH" modified="2025-07-07T20:07:49.669+09:00">有的要一天天地減少，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.57" xml:lang="en" resp="#CH" modified="2025-07-07T20:08:00.726+09:00">增加它的用途而減少它的傷害，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.58" xml:lang="en" resp="#CH" modified="2025-07-07T20:08:08.234+09:00">有時減少的少而增加的多.</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.59" xml:lang="en" resp="#CH" modified="2025-07-07T20:08:25.72+09:00">有時減少的多而增加的少，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.60" xml:lang="en" resp="#CH" modified="2025-07-07T20:08:29.104+09:00">減少而不至於絕滅，</seg>
                    <seg corresp="#CH1e0879_CHANT_012-6a.61" xml:lang="en" resp="#CH" modified="2025-07-07T20:08:54.176+09:00">增多而不至於盈滿。</seg>
                </p>
            </div>
        </body>
