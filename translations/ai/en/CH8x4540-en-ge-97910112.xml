    <seg corresp="#CH8x4540_CHANT_002-1a.1-h" xml:lang="en" resp="#gemini-gemini-3-flash-preview" generatedBy="bot-gemini-3-flash-preview" modified="2026-04-29T22:35:38.583Z">One</seg>
    <seg corresp="#CH8x4540_CHANT_003-1a.1-h" xml:lang="en" resp="#gemini-gemini-3-flash-preview" generatedBy="bot-gemini-3-flash-preview" modified="2026-04-29T22:35:38.583Z">Two</seg>
    <seg corresp="#CH8x4540_CHANT_004-1a.1-h" xml:lang="en" resp="#gemini-gemini-3-flash-preview" generatedBy="bot-gemini-3-flash-preview" modified="2026-04-29T22:35:38.583Z">Three</seg>
    <seg corresp="#CH8x4540_CHANT_005-1a.1-h" xml:lang="en" resp="#gemini-gemini-3-flash-preview" generatedBy="bot-gemini-3-flash-preview" modified="2026-04-29T22:35:38.583Z">Four</seg>
    <seg corresp="#CH8x4540_CHANT_006-1a.1-h" xml:lang="en" resp="#gemini-gemini-3-flash-preview" generatedBy="bot-gemini-3-flash-preview" modified="2026-04-29T22:35:38.584Z">Five</seg>
  </p>
