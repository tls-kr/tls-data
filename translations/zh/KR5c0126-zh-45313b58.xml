    <text>
        <body>
            <div>
                <head>Translated parts</head>
                <p xml:id="KR5c0126-start">
                    <seg corresp="#KR5c0126_tls_001-1a.3" xml:lang="en" resp="#XiaoDing" modified="2025-07-09T13:02:06.571+09:00">北海有一条鱼，</seg>
                    <seg corresp="#KR5c0126_tls_001-1a.4" xml:lang="en" resp="#XiaoDing" modified="2025-07-09T13:03:36.967+09:00">它的名字叫做鲲。</seg>
                    <seg corresp="#KR5c0126_tls_001-1a.5" xml:lang="en" resp="#XiaoDing" modified="2025-07-09T14:07:49.876+09:00">鲲的巨大，</seg>
                    <seg corresp="#KR5c0126_tls_001-1a.7" xml:lang="en" resp="#XiaoDing" modified="2025-07-09T14:07:38.537+09:00">化成为鸟，</seg>
                    <seg corresp="#KR5c0126_tls_001-1a.8" xml:lang="en" resp="#XiaoDing" modified="2025-07-09T14:07:45.508+09:00">它的名字叫做鹏。</seg>
                    <seg corresp="#KR5c0126_tls_001-1a.6" xml:lang="en" resp="#XiaoDing" modified="2025-07-09T14:07:54.681+09:00">不知道有几千里。 </seg>
                    <seg corresp="#KR5c0126_tls_001-1a.9" xml:lang="en" resp="#XiaoDing" modified="2025-07-09T14:08:19.597+09:00">鹏的背，</seg>
                    <seg corresp="#KR5c0126_tls_001-1a.10" xml:lang="en" resp="#XiaoDing" modified="2025-07-09T14:08:32.641+09:00">不知道有几千里；</seg>
                    <seg corresp="#KR5c0126_tls_001-1a.11" xml:lang="en" resp="#XiaoDing" modified="2025-07-09T14:08:42.509+09:00">奋起而飞，</seg>
                    <seg corresp="#KR5c0126_tls_001-1a.12" xml:lang="en" resp="#XiaoDing" modified="2025-07-09T14:08:50.606+09:00">它的翅膀就像天边的云。</seg>
                    <seg corresp="#KR5c0126_tls_001-1a.13" xml:lang="en" resp="#XiaoDing" modified="2025-07-09T14:09:02.525+09:00"> 这只鸟， </seg>
                    <seg corresp="#KR5c0126_tls_001-1a.14" xml:lang="en" resp="#XiaoDing" modified="2025-07-09T14:09:08.652+09:00">海动风起时就迁往南海。</seg>
                    <seg corresp="#KR5c0126_tls_001-1a.15" xml:lang="en" resp="#XiaoDing" modified="2025-07-09T14:10:12.623+09:00">那南海，就是天然大池。</seg>
                </p>
            </div>
