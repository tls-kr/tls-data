    <text>
        <body>
            <div>
                <head>Translated parts</head>
                <p xml:id="KR3j0010-start">
                    <seg corresp="#KR3j0010_tls_021-14a.2" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-07T00:03:49.381+09:00">《氾论》篇，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.3" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-07T00:03:59.925+09:00">用来连缀缝隙，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.4" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-07T00:04:06.904+09:00">填补空缺，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.5" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-07T00:04:19.613+09:00">把弯路变成笔直的捷径，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.6" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-07T00:04:22.945+09:00">来推究事物的原本的敢初状态，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.7" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-07T00:04:27.55+09:00">从而预见得与失的变化，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.8" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-07T00:04:36.094+09:00">利与弊的转变，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.9" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-07T00:04:48.364+09:00">因而使人不会被势利淹没，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.10" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-07T00:04:51.953+09:00">不会被纷繁的事务诱惑，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.11" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-07T00:05:01.604+09:00">既符合天道，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.12" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-07T00:05:09.102+09:00">又能看清时势的变化，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.13" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-07T00:05:09.395+09:00">从而与造化相推移。</seg>
                </p>
            </div>
        </body>
