    <text>
        <body>
            <div>
                <head>Translated parts</head>
                <p xml:id="KR3j0010-start">
                    <seg corresp="#KR3j0010_tls_021-14a.2" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T09:01:38.163+09:00">《氾論》篇的內容，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.3" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T09:10:58.278+09:00">主要是說：像縫補破爛的衣服，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.4" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T09:11:02.203+09:00">像木楔不墜在木具的間隙一樣，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.5" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T09:11:10.05+09:00">可以直接地使曲道變為正道，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.6" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T09:11:20.663+09:00">一邊使事物的本來面目顯現，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.7" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T09:12:50.817+09:00">並能預測利害</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.8" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T09:12:59.507+09:00">得失的正反關。</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.9" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T09:13:06.572+09:00">不要沈淪於勢利之中，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.10" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T09:13:12.661+09:00">不要被表面現象所迷惑，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.11" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T09:13:33.364+09:00">這樣才符合天道運行的規律，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.12" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T09:13:56.511+09:00">才能考察時世的變化，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.13" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T09:16:42.308+09:00">才能夠與天道一起變遷。</seg>
                </p>
            </div>
        </body>
