    <text>
        <body>
            <div>
                <head>Translated parts</head>
                <p xml:id="KR3j0010-start">
                    <seg corresp="#KR3j0010_tls_021-14a.2" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T08:19:12.706+09:00">《氾論》一篇</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.3" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T08:20:28.857+09:00">是用來連綴裂縫</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.4" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T08:21:18.559+09:00">櫼塞空隙，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.5" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T08:22:12.875+09:00">直行糾枉，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.6" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T08:22:51.434+09:00">以使推論樸質的本性，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.7" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T08:23:34.971+09:00">而預見得失的流變</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.8" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T08:24:21.334+09:00">和利害的轉化，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.9" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T08:25:16.096+09:00">以便使人不沉於勢利，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.10" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T08:25:36.395+09:00">不惑於事態，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.11" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T08:25:54.623+09:00">符合天道的運行，</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.12" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T08:28:08.568+09:00">並且考稽時世的變化</seg>
                    <seg corresp="#KR3j0010_tls_021-14a.13" generatedBy="human" xml:lang="en" resp="#CH" modified="2025-12-08T08:51:12.247+09:00">и следуя общему ходу изменений.</seg>
                </p>
            </div>
        </body>
