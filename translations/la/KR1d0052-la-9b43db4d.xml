    <text>
        <body>
            <div>
                <head>Translated parts</head>
                <p xml:id="KR1d0052-start">
                    <seg corresp="#KR1d0052_tls_001-1a.3" xml:lang="en" resp="#minmin" modified="2025-09-11T17:30:46.499+09:00">In Minoribus decentie legibus dicitur</seg>
                    <seg corresp="#KR1d0052_tls_001-1a.4" xml:lang="en" resp="#minmin" modified="2025-09-11T17:37:18.465+09:00">Nunquam non reveraris</seg>
                    <seg corresp="#KR1d0052_tls_001-1a.5" xml:lang="en" resp="#minmin" modified="2025-09-11T17:38:07.429+09:00">sis gracis quasi cogitabundus,</seg>
                    <seg corresp="#KR1d0052_tls_001-1a.6" xml:lang="en" resp="#minmin" modified="2025-09-11T17:40:25.663+09:00">pacate praestituas verha;</seg>
                    <seg corresp="#KR1d0052_tls_001-2a.1" xml:lang="en" resp="#minmin" modified="2025-09-11T17:41:20.657+09:00">tranquillum facies populum.</seg>
                    <seg corresp="#KR1d0052_tls_001-2a.2" xml:lang="en" resp="#minmin" modified="2025-09-11T17:42:12.515+09:00">Superbia non decet ut crescat,</seg>
                    <seg corresp="#KR1d0052_tls_001-2a.3" xml:lang="en" resp="#minmin" modified="2025-09-11T17:42:45.993+09:00">cupiditates non decet ut laxentur,</seg>
                    <seg corresp="#KR1d0052_tls_001-2a.4" xml:lang="en" resp="#minmin" modified="2025-09-11T17:43:13.697+09:00">voluntas non decet ut compleatur,</seg>
                    <seg corresp="#KR1d0052_tls_001-3a.1" xml:lang="en" resp="#minmin" modified="2025-09-11T17:43:38.473+09:00">gaudium non decet ut sit summum.</seg>
                    <seg corresp="#KR1d0052_tls_001-3a.2" xml:lang="en" resp="#minmin" modified="2025-09-11T17:45:50.443+09:00">Virtutibus caelerisque dotibus praeditus vir familiariter tractat et reveretur eosdem,</seg>
                    <seg corresp="#KR1d0052_tls_001-3a.4" xml:lang="en" resp="#minmin" modified="2025-09-11T18:03:30.044+09:00">Diligit(amicos),et agnoscit eorum vitia;</seg>
                    <seg corresp="#KR1d0052_tls_001-3a.3" xml:lang="en" resp="#minmin" modified="2025-09-11T18:02:34.362+09:00">veretur et diligit eosdem.</seg>
                    <seg corresp="#KR1d0052_tls_001-3a.5" xml:lang="en" resp="#minmin" modified="2025-09-11T18:04:23.742+09:00">aversatur(malos),et agnoscit eorum bona.</seg>
                    <seg corresp="#KR1d0052_tls_001-3a.6" xml:lang="en" resp="#minmin" modified="2025-09-11T18:05:16.381+09:00">Cougregat,et scit largiri.</seg>
                    <seg corresp="#KR1d0052_tls_001-3a.7" xml:lang="en" resp="#minmin" modified="2025-09-11T18:19:42.799+09:00">Gaudens bonograto,scit migrare(ad aliud bonum).</seg>
                </p>
            </div>
        </body>
