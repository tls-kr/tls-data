    <text>
        <body>
            <div>
                <head>Translated parts</head>
                <p xml:id="KR3a0002-start">
                    <seg corresp="#KR3a0002_tls_001-4a.23" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">Was darin eingetaucht ist, ist unreines Spülwasser,</seg>
                    <seg corresp="#KR3a0002_tls_001-4a.24" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">dem sich der Edle nicht nähert</seg>
                    <seg corresp="#KR3a0002_tls_001-4a.25" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">und das der gemeine Mann nicht trägt.</seg>
                    <seg corresp="#KR3a0002_tls_001-4a.26" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">Nicht, dass seine Beschaffenheit nicht gut wäre,</seg>
                    <seg corresp="#KR3a0002_tls_001-4a.27" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">sondern das, worin es eingetaucht ist, ist so.</seg>
                    <seg corresp="#KR3a0002_tls_001-4a.28" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">Daher wählt der Jūnzǐ</seg>
                    <seg corresp="#KR3a0002_tls_001-4a.29" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">seinen Wohnort sorgfältig aus,</seg>
                    <seg corresp="#KR3a0002_tls_001-4a.30" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">und bei Reisen sucht er die Gelehrten auf,</seg>
                    <seg corresp="#KR3a0002_tls_001-4a.31" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">um sich vor dem Bösen und Abwegigen zu schützen</seg>
                    <seg corresp="#KR3a0002_tls_001-4a.32" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">und der Mitte und dem Rechten nahe zu sein.</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.1" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00"/>
                    <seg corresp="#KR3a0002_tls_001-5a.2" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">Der Ursprung der Dinge</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.3" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">hat immer einen Anfang.</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.4" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">Das Kommen von Ehre und Schande</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.5" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">bildet immer die Tugend ab.</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.6" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">Verfaultes Fleisch erzeugt Maden,</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.7" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">und trockener Fisch erzeugt Holzwürmer.</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.8" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">Lässt man Nachlässigkeit und Selbstvergessenheit walten,</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.9" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">so entstehen Unglück und Katastrophen.</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.10" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">Wer stark ist, holt sich selbst die Säule,</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.11" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">wer schwach ist, holt sich selbst die Fessel.</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.12" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">Ist Unrat und Schmutz am Körper,</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.13" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">so ist das der Grund für Klagen.</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.14" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">Legt man Brennholz wie „eins“ hin,</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.15" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">so greift das Feuer nach dem Trockenen;</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.16" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">ist der Boden eben wie „eins“,</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.17" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">so zieht das Wasser zum Feuchten.</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.18" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">Gräser und Bäume wachsen in Gruppen,</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.19" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">Vögel und Tiere leben in Gemeinschaften,</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.20" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">jedes Ding folgt seiner Art.</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.21" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">Daher wird, wenn die Zielscheibe aufgespannt ist,</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.22" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">Pfeil und Bogen sie erreichen,</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.23" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">und wenn der Wald üppig ist,</seg>
                    <seg corresp="#KR3a0002_tls_001-5a.24" xml:lang="de" resp="#gemini-2.0-flash" modified="2025-10-22T09:46:22.455+09:00">Axt und Beil ihn erreichen.</seg>
                </p>
            </div>
